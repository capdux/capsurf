{
  "name": "capsurf",
  "version": "0.1.0",
  "description": "Million-Agent Native Headless Browser Engine in CP",
  "author": "Antigravity Team",
  "license": "Apache-2.0",
  "main": "src/main.cp",
  "mode": "parallel",
  "scripts": {
    "start": "cap src/main.cp",
    "test": "cap test test/",
    "build": "cap build -r -f",
    "build:nest": "cap build -b"
  },
  "build": {
    "opt": "fast",
    "out_dir": "bin",
    "c_flags": ["-D_GNU_SOURCE", "-Lvendor/quickjs/build"],
    "link_libs": ["c", "m", "pthread", "qjs"]
  },
  "nest": {
    "mailbox_capacity": 65536,
    "reduction_slice": 2000
  }
}
