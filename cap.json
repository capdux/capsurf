{
  "name": "capsurf",
  "version": "0.1.0",
  "description": "Million-Agent Native Headless Browser Engine in CP",
  "author": "Antigravity Team",
  "license": "Apache-2.0",
  "main": "src/main.cp",
  "mode": "parallel",
  "scripts": {
    "start": "cap src/main.cp",
    "test": "cap test test/unit/",
    "build": "cap build -r -f",
    "build:nest": "cap build -b"
  },
  "bin_dependencies": {
    "quickjs": "0.1.0",
    "zlib": "1.3.1"
  },
  "build": {
    "entry": "src/main.cp",
    "targets": ["native"],
    "opt": "fast",
    "out_dir": "bin",
    "c_flags": ["-D_GNU_SOURCE"]
  },
  "nest": {
    "mailbox_capacity": 65536,
    "reduction_slice": 2000
  }
}
