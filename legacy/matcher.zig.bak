                return comp;
            }
            if (std.mem.indexOfScalar(u8, s, 61)) |eq_idx| {
                _ = &eq_idx;
                var lhs = s[0..eq_idx];
                _ = &lhs;
                var op = AttrOperator.Equal;
                _ = &op;
                if ((lhs.len > 0)) {
                    const last_c = lhs[@as(usize, @intCast((lhs.len - 1)))];
                    if ((last_c == 126)) {
                        op = AttrOperator.Includes;
                        lhs = lhs[0..(lhs.len - 1)];
                    } else {
                        if ((last_c == 124)) {
                            op = AttrOperator.DashMatch;
                            lhs = lhs[0..(lhs.len - 1)];
                        } else {
                            if ((last_c == 94)) {
                                op = AttrOperator.Prefix;
                                lhs = lhs[0..(lhs.len - 1)];
                            } else {
                                if ((last_c == 36)) {
                                    op = AttrOperator.Suffix;
                                    lhs = lhs[0..(lhs.len - 1)];
                                } else {
                                    if ((last_c == 42)) {
                                        op = AttrOperator.Substring;
                                        lhs = lhs[0..(lhs.len - 1)];
                                    }
                                }
                            }
                        }
                    }
                }
                comp.ident = std.mem.trim(u8, lhs, " \t");
                comp.attr_op = op;
                var rhs = std.mem.trim(u8, s[(eq_idx + 1)..s.len], " \t");
                _ = &rhs;
                if (((rhs.len >= 2) and ((rhs[@as(usize, @intCast((rhs.len - 2)))] == 32) or (rhs[@as(usize, @intCast((rhs.len - 2)))] == 9)))) {
                    const flag_ch = rhs[@as(usize, @intCast((rhs.len - 1)))];
                    if (((flag_ch == 105) or (flag_ch == 73))) {
                        comp.attr_case_insensitive = true;
                        rhs = std.mem.trim(u8, rhs[0..(rhs.len - 2)], " \t");
                    } else {
                        if (((flag_ch == 115) or (flag_ch == 83))) {
                            comp.attr_case_insensitive = false;
                            rhs = std.mem.trim(u8, rhs[0..(rhs.len - 2)], " \t");
                        }
                    }
                }
                comp.attr_val = std.mem.trim(u8, rhs, "\"'");
            } else {
                comp.ident = s;
            }
            return comp;
    }

pub fn maxSpecificityOfList(raw_list: []const u8) Specificity {
            var best = Specificity{  };
            _ = &best;
            var best_score: u32 = 0;
            _ = &best_score;
            var start: usize = 0;
            _ = &start;
            var i: usize = 0;
            _ = &i;
            var depth: usize = 0;
            _ = &depth;
            while ((i <= raw_list.len)) : (i = (i + 1)) {
                const at_end = (i == raw_list.len);
                if ((!at_end)) {
                    if ((raw_list[@as(usize, @intCast(i))] == 40)) {
                        depth = (depth + 1);
                    }
                    if (((raw_list[@as(usize, @intCast(i))] == 41) and (depth > 0))) {
                        depth = (depth - 1);
                    }
                }
                if ((at_end or ((raw_list[@as(usize, @intCast(i))] == 44) and (depth == 0)))) {
                    var sub = std.mem.trim(u8, raw_list[start..i], " \t\r\n");
                    _ = &sub;
                    if (((sub.len > 0) and (((sub[0] == 62) or (sub[0] == 43)) or (sub[0] == 126)))) {
                        sub = std.mem.trim(u8, sub[1..sub.len], " \t\r\n");
                    }
                    if ((sub.len > 0)) {
                        const parsed = SelectorParser.parseSingleSelector(sub);
                        const sc = parsed.specificity.toU32();
                        if ((sc >= best_score)) {
                            best_score = sc;
                            best = parsed.specificity;
                        }
                    }
                    start = (i + 1);
                }
            }
            return best;
    }

pub fn extractPseudoArg(s: []const u8, i_ptr: *usize) []const u8 {
            var i = i_ptr.*;
            _ = &i;
            if (((i < s.len) and (s[@as(usize, @intCast(i))] == 40))) {
                i = (i + 1);
                const arg_start = i;
                var depth: usize = 1;
                _ = &depth;
                while (((i < s.len) and (depth > 0))) : (i = (i + 1)) {
                    if ((s[@as(usize, @intCast(i))] == 40)) {
                        depth = (depth + 1);
                    }
                    if ((s[@as(usize, @intCast(i))] == 41)) {
                        depth = (depth - 1);
                    }
                }
                i_ptr.* = i;
                if ((i > arg_start)) {
                    return std.mem.trim(u8, s[arg_start..(i - 1)], " \t\r\n");
                }
            }
            return "";
    }

pub fn parseSingleSelector(raw_in: []const u8) Selector {
            const s = std.mem.trim(u8, raw_in, " \t\r\n");
            var result = Selector{ .raw = s };
            _ = &result;
            if ((s.len == 0)) {
                return result;
            }
            var left_to_right: [24]Component = @as([24]Component, @splat(@as(Component, Component{  })));
            _ = &left_to_right;
            var ltr_count: usize = 0;
            _ = &ltr_count;
            var compounds: [12]CompoundSpan = @as([12]CompoundSpan, @splat(@as(CompoundSpan, CompoundSpan{  })));
            _ = &compounds;
            var compound_count: usize = 0;
            _ = &compound_count;
            var cur_compound_start: usize = 0;
            _ = &cur_compound_start;
            var cur_compound_len: usize = 0;
            _ = &cur_compound_len;
            var pending_combinator = Combinator.Descendant;
            _ = &pending_combinator;
            var has_pending_combinator = false;
            _ = &has_pending_combinator;
            var spec = Specificity{  };
            _ = &spec;
            var i: usize = 0;
            _ = &i;
            while (((i < s.len) and (ltr_count < MAX_COMPONENTS_PER_SELECTOR))) {
                const c = s[@as(usize, @intCast(i))];
                if ((((((((c == 32) or (c == 9)) or (c == 13)) or (c == 10)) or (c == 62)) or (c == 43)) or (c == 126))) {
                    var comb = Combinator.Descendant;
                    _ = &comb;
                    while ((i < s.len)) {
                        const ch = s[@as(usize, @intCast(i))];
                        if ((ch == 62)) {
                            comb = Combinator.Child;
                            i = (i + 1);
                        } else {
                            if ((ch == 43)) {
                                comb = Combinator.NextSibling;
                                i = (i + 1);
                            } else {
                                if ((ch == 126)) {
                                    comb = Combinator.LaterSibling;
                                    i = (i + 1);
                                } else {
                                    if (((((ch == 32) or (ch == 9)) or (ch == 13)) or (ch == 10))) {
                                        i = (i + 1);
                                    } else {
                                        break;
                                    }
                                }
                            }
                        }
                    }
                    if (((cur_compound_len > 0) and (compound_count < 12))) {
                        compounds[cp_cast_int(usize, compound_count)] = CompoundSpan{ .start = cur_compound_start, .len = cur_compound_len, .combinator_before = pending_combinator, .has_combinator_before = has_pending_combinator };
                        compound_count = (compound_count + 1);
                        cur_compound_start = ltr_count;
                        cur_compound_len = 0;
                        pending_combinator = comb;
                        has_pending_combinator = true;
                    }
                    continue;
                }
                if ((c == 42)) {
                    left_to_right[cp_cast_int(usize, ltr_count)] = Component{ .kind = ComponentKind.Universal };
                    ltr_count = (ltr_count + 1);
                    cur_compound_len = (cur_compound_len + 1);
                    i = (i + 1);
                    continue;
                }
                if ((c == 35)) {
                    i = (i + 1);
                    const start = i;
                    while (((i < s.len) and SelectorParser.isIdentChar(s[@as(usize, @intCast(i))]))) : (i = (i + 1)) {
                    }
                    const id_name = s[start..i];
                    if ((id_name.len > 0)) {
                        left_to_right[cp_cast_int(usize, ltr_count)] = Component{ .kind = ComponentKind.Id, .ident = id_name };
                        ltr_count = (ltr_count + 1);
                        cur_compound_len = (cur_compound_len + 1);
                        spec.id_selectors = (spec.id_selectors + 1);
                    }
                    continue;
                }
                if ((c == 46)) {
                    i = (i + 1);
                    const start = i;
                    while (((i < s.len) and SelectorParser.isIdentChar(s[@as(usize, @intCast(i))]))) : (i = (i + 1)) {
                    }
                    const cls_name = s[start..i];
                    if ((cls_name.len > 0)) {
                        left_to_right[cp_cast_int(usize, ltr_count)] = Component{ .kind = ComponentKind.Class, .ident = cls_name };
                        ltr_count = (ltr_count + 1);
                        cur_compound_len = (cur_compound_len + 1);
                        spec.class_like_selectors = (spec.class_like_selectors + 1);
                    }
                    continue;
                }
                if ((c == 91)) {
                    i = (i + 1);
                    const start = i;
                    while (((i < s.len) and (s[@as(usize, @intCast(i))] != 93))) : (i = (i + 1)) {
                    }
                    const inside = s[start..i];
                    if (((i < s.len) and (s[@as(usize, @intCast(i))] == 93))) {
                        i = (i + 1);
                    }
                    left_to_right[cp_cast_int(usize, ltr_count)] = SelectorParser.parseAttributeComponent(inside);
                    ltr_count = (ltr_count + 1);
                    cur_compound_len = (cur_compound_len + 1);
                    spec.class_like_selectors = (spec.class_like_selectors + 1);
                    continue;
                }
                if ((c == 58)) {
                    if ((((i + 1) < s.len) and (s[@as(usize, @intCast((i + 1)))] == 58))) {
                        i = (i + 2);
                        while (((i < s.len) and SelectorParser.isIdentChar(s[@as(usize, @intCast(i))]))) : (i = (i + 1)) {
                        }
                        spec.element_selectors = (spec.element_selectors + 1);
                        continue;
                    }
                    i = (i + 1);
                    const name_start = i;
                    while (((i < s.len) and SelectorParser.isIdentChar(s[@as(usize, @intCast(i))]))) : (i = (i + 1)) {
                    }
                    const p_name = s[name_start..i];
                    const arg_raw = SelectorParser.extractPseudoArg(s, (&i));
                    var p_comp = Component{ .kind = ComponentKind.Pseudo, .ident = p_name, .sub_selector_raw = arg_raw };
                    _ = &p_comp;
                    if (std.ascii.eqlIgnoreCase(p_name, "root")) {
                        p_comp.pseudo_kind = PseudoKind.Root;
                        spec.class_like_selectors = (spec.class_like_selectors + 1);
                    } else {
                        if (std.ascii.eqlIgnoreCase(p_name, "empty")) {
                            p_comp.pseudo_kind = PseudoKind.Empty;
                            spec.class_like_selectors = (spec.class_like_selectors + 1);
                        } else {
                            if (std.ascii.eqlIgnoreCase(p_name, "first-child")) {
                                p_comp.pseudo_kind = PseudoKind.FirstChild;
                                spec.class_like_selectors = (spec.class_like_selectors + 1);
                            } else {
                                if (std.ascii.eqlIgnoreCase(p_name, "last-child")) {
                                    p_comp.pseudo_kind = PseudoKind.LastChild;
                                    spec.class_like_selectors = (spec.class_like_selectors + 1);
                                } else {
                                    if (std.ascii.eqlIgnoreCase(p_name, "only-child")) {
                                        p_comp.pseudo_kind = PseudoKind.OnlyChild;
                                        spec.class_like_selectors = (spec.class_like_selectors + 1);
                                    } else {
                                        if (std.ascii.eqlIgnoreCase(p_name, "first-of-type")) {
                                            p_comp.pseudo_kind = PseudoKind.FirstOfType;
                                            spec.class_like_selectors = (spec.class_like_selectors + 1);
                                        } else {
                                            if (std.ascii.eqlIgnoreCase(p_name, "last-of-type")) {
                                                p_comp.pseudo_kind = PseudoKind.LastOfType;
                                                spec.class_like_selectors = (spec.class_like_selectors + 1);
                                            } else {
                                                if (std.ascii.eqlIgnoreCase(p_name, "only-of-type")) {
                                                    p_comp.pseudo_kind = PseudoKind.OnlyOfType;
                                                    spec.class_like_selectors = (spec.class_like_selectors + 1);
                                                } else {
                                                    if (std.ascii.eqlIgnoreCase(p_name, "nth-child")) {
                                                        p_comp.pseudo_kind = PseudoKind.NthChild;
                                                        const ab = SelectorParser.parseNthFormula(arg_raw);
                                                        p_comp.nth_a = ab.a;
                                                        p_comp.nth_b = ab.b;
                                                        spec.class_like_selectors = (spec.class_like_selectors + 1);
                                                    } else {
                                                        if (std.ascii.eqlIgnoreCase(p_name, "nth-last-child")) {
                                                            p_comp.pseudo_kind = PseudoKind.NthLastChild;
                                                            const ab = SelectorParser.parseNthFormula(arg_raw);
                                                            p_comp.nth_a = ab.a;
                                                            p_comp.nth_b = ab.b;
                                                            spec.class_like_selectors = (spec.class_like_selectors + 1);
                                                        } else {
                                                            if (std.ascii.eqlIgnoreCase(p_name, "where")) {
                                                                p_comp.pseudo_kind = PseudoKind.Where;
                                                            } else {
                                                                if ((std.ascii.eqlIgnoreCase(p_name, "is") or std.ascii.eqlIgnoreCase(p_name, "matches"))) {
                                                                    p_comp.pseudo_kind = PseudoKind.Is;
                                                                    _ = spec.add(SelectorParser.maxSpecificityOfList(arg_raw));
                                                                } else {
                                                                    if (std.ascii.eqlIgnoreCase(p_name, "not")) {
                                                                        p_comp.pseudo_kind = PseudoKind.Not;
                                                                        _ = spec.add(SelectorParser.maxSpecificityOfList(arg_raw));
                                                                    } else {
                                                                        if (std.ascii.eqlIgnoreCase(p_name, "has")) {
                                                                            p_comp.pseudo_kind = PseudoKind.Has;
                                                                            var rel = arg_raw;
                                                                            _ = &rel;
                                                                            var rel_comb = Combinator.Descendant;
                                                                            _ = &rel_comb;
                                                                            if ((rel.len > 0)) {
                                                                                if ((rel[0] == 62)) {
                                                                                    rel_comb = Combinator.Child;
                                                                                    rel = std.mem.trim(u8, rel[1..rel.len], " \t\r\n");
                                                                                } else {
                                                                                    if ((rel[0] == 43)) {
                                                                                        rel_comb = Combinator.NextSibling;
                                                                                        rel = std.mem.trim(u8, rel[1..rel.len], " \t\r\n");
                                                                                    } else {
                                                                                        if ((rel[0] == 126)) {
                                                                                            rel_comb = Combinator.LaterSibling;
                                                                                            rel = std.mem.trim(u8, rel[1..rel.len], " \t\r\n");
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                            p_comp.has_combinator = rel_comb;
                                                                            p_comp.sub_selector_raw = rel;
                                                                            _ = spec.add(SelectorParser.maxSpecificityOfList(rel));
                                                                        } else {
                                                                            if (std.ascii.eqlIgnoreCase(p_name, "focus")) {
                                                                                p_comp.pseudo_kind = PseudoKind.Focus;
                                                                                spec.class_like_selectors = (spec.class_like_selectors + 1);
                                                                            } else {
                                                                                spec.class_like_selectors = (spec.class_like_selectors + 1);
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    left_to_right[cp_cast_int(usize, ltr_count)] = p_comp;
                    ltr_count = (ltr_count + 1);
                    cur_compound_len = (cur_compound_len + 1);
                    continue;
                }
                if (SelectorParser.isIdentChar(c)) {
                    const start = i;
                    while (((i < s.len) and SelectorParser.isIdentChar(s[@as(usize, @intCast(i))]))) : (i = (i + 1)) {
                    }
                    const tag = s[start..i];
                    left_to_right[cp_cast_int(usize, ltr_count)] = Component{ .kind = ComponentKind.LocalName, .ident = tag, .ident_hash = NodeData.hashLowerAscii(tag) };
                    ltr_count = (ltr_count + 1);
                    cur_compound_len = (cur_compound_len + 1);
                    spec.element_selectors = (spec.element_selectors + 1);
                    continue;
                }
                i = (i + 1);
            }
            if (((cur_compound_len > 0) and (compound_count < 12))) {
                compounds[cp_cast_int(usize, compound_count)] = CompoundSpan{ .start = cur_compound_start, .len = cur_compound_len, .combinator_before = pending_combinator, .has_combinator_before = has_pending_combinator };
                compound_count = (compound_count + 1);
            }
            var out_idx: usize = 0;
            _ = &out_idx;
            var c_idx: usize = compound_count;
            _ = &c_idx;
            while ((c_idx > 0)) {
                c_idx = (c_idx - 1);
                const span = compounds[@as(usize, @intCast(c_idx))];
                var k: usize = 0;
                _ = &k;
                while (((k < span.len) and (out_idx < MAX_COMPONENTS_PER_SELECTOR))) : (k = (k + 1)) {
                    result.components[cp_cast_int(usize, out_idx)] = left_to_right[@as(usize, @intCast((span.start + k)))];
                    out_idx = (out_idx + 1);
                }
                if ((span.has_combinator_before and (out_idx < MAX_COMPONENTS_PER_SELECTOR))) {
                    result.components[cp_cast_int(usize, out_idx)] = Component{ .kind = ComponentKind.CombinatorComp, .combinator = span.combinator_before };
                    out_idx = (out_idx + 1);
                }
            }
            result.comp_count = out_idx;
            result.specificity = spec;
            return result;
    }
};

pub const Matcher = struct {

pub fn strEql(a: []const u8, b: []const u8, case_insensitive: bool) bool {
            if (case_insensitive) {
                return std.ascii.eqlIgnoreCase(a, b);
            }
            return std.mem.eql(u8, a, b);
    }

pub fn matchesAttribute(node: *const NodeData, comp: *const Component) bool {
            const val_opt = node.getAttribute(comp.ident);
            if ((val_opt == null)) {
                return false;
            }
            const actual = ((val_opt) orelse (""));
            const expected = comp.attr_val;
            const ci = comp.attr_case_insensitive;
            return (switch (comp.attr_op) {
.Exists => true,
.Equal => Matcher.strEql(actual, expected, ci),
.Includes => {
{
                if ((expected.len == 0)) {
                    return false;
                }
                var it = std.mem.tokenizeAny(u8, actual, " \t\r\n");
                _ = &it;
                while (it.next()) |word| {
                    if (Matcher.strEql(word, expected, ci)) {
                        return true;
                    }
                }
                return false;
            }
},
.DashMatch => {
{
                if (Matcher.strEql(actual, expected, ci)) {
                    return true;
                }
                if (((actual.len > expected.len) and (actual[@as(usize, @intCast(expected.len))] == 45))) {
                    return Matcher.strEql(actual[0..expected.len], expected, ci);
                }
                return false;
            }
},
.Prefix => {
{
                if (((expected.len == 0) or (actual.len < expected.len))) {
                    return false;
                }
                return Matcher.strEql(actual[0..expected.len], expected, ci);
            }
},
.Suffix => {
{
                if (((expected.len == 0) or (actual.len < expected.len))) {
                    return false;
                }
                return Matcher.strEql(actual[(actual.len - expected.len)..actual.len], expected, ci);
            }
},
.Substring => {
{
                if (((expected.len == 0) or (actual.len < expected.len))) {
                    return false;
                }
                if ((!ci)) {
                    return (std.mem.indexOf(u8, actual, expected) != null);
                }
                var pos: usize = 0;
                _ = &pos;
                while (((pos + expected.len) <= actual.len)) : (pos = (pos + 1)) {
                    if (std.ascii.eqlIgnoreCase(actual[pos..(pos + expected.len)], expected)) {
                        return true;
                    }
                }
                return false;
            }
},
});
    }

pub fn matchesNthEquation(a: i32, b: i32, index: i32) bool {
            if ((a == 0)) {
                return (index == b);
            }
            const diff = (index - b);
            if ((a > 0)) {
                if ((diff < 0)) {
                    return false;
                }
                return (@rem(diff, a) == 0);
            }
            if ((diff > 0)) {
                return false;
            }
            return (@rem(diff, a) == 0);
    }

pub fn matchesPseudo(doc: *const Document, node_id: NodeId, comp: *const Component) bool {
            const node = (&doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(node_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(node_id)) else cp_cast_int(usize, node_id))))]);
            const parent_id = node.parent;
            return (switch (comp.pseudo_kind) {
.Root => (node_id == doc.root_element),
.Empty => doc.isEmptyElement(node_id),
.FirstChild => (node.element_index_in_parent == 1),
.LastChild => {
{
                if ((parent_id == NULL_NODE)) {
                    return false;
                }
                const total = doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(parent_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(parent_id)) else cp_cast_int(usize, parent_id))))].child_element_count;
                return ((total > 0) and (node.element_index_in_parent == total));
            }
},
.OnlyChild => {
{
                if ((parent_id == NULL_NODE)) {
                    return false;
                }
                return (doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(parent_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(parent_id)) else cp_cast_int(usize, parent_id))))].child_element_count == 1);
            }
},
.FirstOfType => {
{
                var prev = doc.prevElementSibling(node_id);
                _ = &prev;
                while ((prev != NULL_NODE)) {
                    if (doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(prev)) == .@"enum") cp_cast_int(usize, @intFromEnum(prev)) else cp_cast_int(usize, prev))))].hasTag(node.tag_name)) {
                        return false;
                    }
                    prev = doc.prevElementSibling(prev);
                }
                return true;
            }
},
.LastOfType => {
{
                var next = doc.nextElementSibling(node_id);
                _ = &next;
                while ((next != NULL_NODE)) {
                    if (doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(next)) == .@"enum") cp_cast_int(usize, @intFromEnum(next)) else cp_cast_int(usize, next))))].hasTag(node.tag_name)) {
                        return false;
                    }
                    next = doc.nextElementSibling(next);
                }
                return true;
            }
},
.OnlyOfType => {
{
                var prev = doc.prevElementSibling(node_id);
                _ = &prev;
                while ((prev != NULL_NODE)) {
                    if (doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(prev)) == .@"enum") cp_cast_int(usize, @intFromEnum(prev)) else cp_cast_int(usize, prev))))].hasTag(node.tag_name)) {
                        return false;
                    }
                    prev = doc.prevElementSibling(prev);
                }
                var next = doc.nextElementSibling(node_id);
                _ = &next;
                while ((next != NULL_NODE)) {
                    if (doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(next)) == .@"enum") cp_cast_int(usize, @intFromEnum(next)) else cp_cast_int(usize, next))))].hasTag(node.tag_name)) {
                        return false;
                    }
                    next = doc.nextElementSibling(next);
                }
                return true;
            }
},
.NthChild => {
{
                if ((node.element_index_in_parent == 0)) {
                    return false;
                }
                return Matcher.matchesNthEquation(comp.nth_a, comp.nth_b, @intCast(node.element_index_in_parent));
            }
},
.NthLastChild => {
{
                if (((parent_id == NULL_NODE) or (node.element_index_in_parent == 0))) {
                    return false;
                }
                const total = doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(parent_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(parent_id)) else cp_cast_int(usize, parent_id))))].child_element_count;
                const from_end: i32 = @intCast(((total - node.element_index_in_parent) + 1));
                return Matcher.matchesNthEquation(comp.nth_a, comp.nth_b, from_end);
            }
},
.Is, .Where => {
{
                const sub_list = SelectorList.parse(comp.sub_selector_raw);
                return Matcher.matchesSelectorList(doc, node_id, sub_list);
            }
},
.Not => {
{
                const sub_list = SelectorList.parse(comp.sub_selector_raw);
                if (Matcher.matchesSelectorList(doc, node_id, sub_list)) {
                    return false;
                }
                return true;
            }
},
.Has => {
{
                const sub_list = SelectorList.parse(comp.sub_selector_raw);
                return (switch (comp.has_combinator) {
.Child => {
{
                    var ch = node.first_child;
                    _ = &ch;
                    while ((ch != NULL_NODE)) {
                        if ((doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(ch)) == .@"enum") cp_cast_int(usize, @intFromEnum(ch)) else cp_cast_int(usize, ch))))].node_type == NodeType.Element)) {
                            if (Matcher.matchesSelectorList(doc, ch, sub_list)) {
                                return true;
                            }
                        }
                        ch = doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(ch)) == .@"enum") cp_cast_int(usize, @intFromEnum(ch)) else cp_cast_int(usize, ch))))].next_sibling;
                    }
                    return false;
                }
},
.NextSibling => {
{
                    const nxt = doc.nextElementSibling(node_id);
                    if ((nxt == NULL_NODE)) {
                        return false;
                    }
                    return Matcher.matchesSelectorList(doc, nxt, sub_list);
                }
},
.LaterSibling => {
{
                    var nxt = doc.nextElementSibling(node_id);
                    _ = &nxt;
                    while ((nxt != NULL_NODE)) {
                        if (Matcher.matchesSelectorList(doc, nxt, sub_list)) {
                            return true;
                        }
                        nxt = doc.nextElementSibling(nxt);
                    }
                    return false;
                }
},
.Descendant => {
return Matcher.subtreeMatches(doc, node_id, sub_list);
},
});
            }
},
.Focus => ((node_id != NULL_NODE) and (node_id == doc.focused_node)),
});
    }

pub fn subtreeMatches(doc: *const Document, root_id: NodeId, sub_list: SelectorList) bool {
            var ch = doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(root_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(root_id)) else cp_cast_int(usize, root_id))))].first_child;
            _ = &ch;
            while ((ch != NULL_NODE)) {
                if ((doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(ch)) == .@"enum") cp_cast_int(usize, @intFromEnum(ch)) else cp_cast_int(usize, ch))))].node_type == NodeType.Element)) {
                    if (Matcher.matchesSelectorList(doc, ch, sub_list)) {
                        return true;
                    }
                    if (Matcher.subtreeMatches(doc, ch, sub_list)) {
                        return true;
                    }
                }
                ch = doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(ch)) == .@"enum") cp_cast_int(usize, @intFromEnum(ch)) else cp_cast_int(usize, ch))))].next_sibling;
            }
            return false;
    }

pub fn matchesSimpleComponent(doc: *const Document, node_id: NodeId, comp: *const Component) bool {
            const node = (&doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(node_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(node_id)) else cp_cast_int(usize, node_id))))]);
            if ((node.node_type != NodeType.Element)) {
                return false;
            }
            return (switch (comp.kind) {
.Universal => true,
.LocalName => {
{
                if ((node.tag_name.len != comp.ident.len)) {
                    return false;
                }
                if ((node.local_name_hash != comp.ident_hash)) {
                    return false;
                }
                return std.ascii.eqlIgnoreCase(node.tag_name, comp.ident);
            }
},
.Id => node.hasId(comp.ident),
.Class => node.hasClass(comp.ident),
.Attribute => Matcher.matchesAttribute(node, comp),
.Pseudo => Matcher.matchesPseudo(doc, node_id, comp),
.CombinatorComp => false,
});
    }

pub fn matchFromIndex(doc: *const Document, node_id: NodeId, sel: *const Selector, comp_idx: usize) bool {
            if (((node_id == NULL_NODE) or ((if (comptime @typeInfo(@TypeOf(node_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(node_id)) else cp_cast_int(usize, node_id)) >= doc.nodes.items.len))) {
                return false;
            }
            var idx = comp_idx;
            _ = &idx;
            while ((idx < sel.comp_count)) {
                const comp = (&sel.components[@as(usize, @intCast(idx))]);
                if ((comp.kind == ComponentKind.CombinatorComp)) {
                    const next_idx = (idx + 1);
                    const node = (&doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(node_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(node_id)) else cp_cast_int(usize, node_id))))]);
                    return (switch (comp.combinator) {
.Child => {
{
                        const p = node.parent;
                        if (((p == NULL_NODE) or (doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(p)) == .@"enum") cp_cast_int(usize, @intFromEnum(p)) else cp_cast_int(usize, p))))].node_type != NodeType.Element))) {
                            return false;
                        }
                        return Matcher.matchFromIndex(doc, p, sel, next_idx);
                    }
},
.Descendant => {
{
                        var anc = node.parent;
                        _ = &anc;
                        while ((anc != NULL_NODE)) {
                            if ((doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(anc)) == .@"enum") cp_cast_int(usize, @intFromEnum(anc)) else cp_cast_int(usize, anc))))].node_type == NodeType.Element)) {
                                if (Matcher.matchFromIndex(doc, anc, sel, next_idx)) {
                                    return true;
                                }
                            }
                            anc = doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(anc)) == .@"enum") cp_cast_int(usize, @intFromEnum(anc)) else cp_cast_int(usize, anc))))].parent;
                        }
                        return false;
                    }
},
.NextSibling => {
{
                        const prev = doc.prevElementSibling(node_id);
                        if ((prev == NULL_NODE)) {
                            return false;
                        }
                        return Matcher.matchFromIndex(doc, prev, sel, next_idx);
                    }
},
.LaterSibling => {
{
                        var prev = doc.prevElementSibling(node_id);
                        _ = &prev;
                        while ((prev != NULL_NODE)) {
                            if (Matcher.matchFromIndex(doc, prev, sel, next_idx)) {
                                return true;
                            }
                            prev = doc.prevElementSibling(prev);
                        }
                        return false;
                    }
},
});
                }
                if ((!Matcher.matchesSimpleComponent(doc, node_id, comp))) {
                    return false;
                }
                idx = (idx + 1);
            }
            return true;
    }

pub fn matchesSelector(doc: *const Document, node_id: NodeId, sel: *const Selector) bool {
            if ((sel.comp_count == 0)) {
                return false;
            }
            return Matcher.matchFromIndex(doc, node_id, sel, 0);
    }

pub fn matchesSelectorList(doc: *const Document, node_id: NodeId, list: SelectorList) bool {
            var i: usize = 0;
            _ = &i;
            while ((i < list.count)) : (i = (i + 1)) {
                if (Matcher.matchesSelector(doc, node_id, (&list.selectors[@as(usize, @intCast(i))]))) {
                    return true;
                }
            }
            return false;
    }

pub fn matchBestSpecificity(doc: *const Document, node_id: NodeId, list: *const SelectorList) ?u32 {
            var matched = false;
            _ = &matched;
            var max_spec: u32 = 0;
            _ = &max_spec;
            var i: usize = 0;
            _ = &i;
            while ((i < list.count)) : (i = (i + 1)) {
                const sel = (&list.selectors[@as(usize, @intCast(i))]);
                if (Matcher.matchesSelector(doc, node_id, sel)) {
                    matched = true;
                    const sp = sel.specificityU32();
                    if ((sp >= max_spec)) {
                        max_spec = sp;
                    }
                }
            }
            if ((!matched)) {
                return null;
            }
            return max_spec;
    }

pub fn querySelector(doc: *const Document, selector_str: []const u8) NodeId {
            const list = SelectorList.parse(selector_str);
            if ((list.count == 0)) {
                return NULL_NODE;
            }
            var i: usize = 1;
            _ = &i;
            while ((i < doc.nodes.items.len)) : (i = (i + 1)) {
                if ((doc.nodes.items[@as(usize, @intCast(i))].node_type == NodeType.Element)) {
                    const nid: NodeId = @intCast(i);
                    if ((doc.isConnectedNode(nid) and Matcher.matchesSelectorList(doc, nid, list))) {
                        return nid;
                    }
                }
            }
            return NULL_NODE;
    }

pub fn querySelectorAll(doc: *const Document, selector_str: []const u8, out_ids: []NodeId) usize {
            const list = SelectorList.parse(selector_str);
            if ((list.count == 0)) {
                return 0;
            }
            var count: usize = 0;
            _ = &count;
            var i: usize = 1;
            _ = &i;
            while (((i < doc.nodes.items.len) and (count < out_ids.len))) : (i = (i + 1)) {
                if ((doc.nodes.items[@as(usize, @intCast(i))].node_type == NodeType.Element)) {
                    const nid: NodeId = @intCast(i);
                    if ((doc.isConnectedNode(nid) and Matcher.matchesSelectorList(doc, nid, list))) {
                        out_ids[cp_cast_int(usize, count)] = nid;
                        count = (count + 1);
                    }
                }
            }
            return count;
    }
};

pub const MAX_COMPONENTS_PER_SELECTOR: usize = 24;
pub const MAX_SELECTORS_PER_LIST: usize = 8;
