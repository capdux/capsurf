    console_count: usize = 0,
    fetch_records: [MAX_FETCH_RECORDS]FetchRecord = @as([MAX_FETCH_RECORDS]FetchRecord, @splat(@as(FetchRecord, FetchRecord{  }))),
    fetch_count: usize = 0,
    frame_id_buf: [64]u8 = @as([64]u8, @splat(@as(u8, 0))),
    frame_id_len: usize = 0,
    loader_id_buf: [64]u8 = @as([64]u8, @splat(@as(u8, 0))),
    loader_id_len: usize = 0,

pub fn addFetchRecord(self: *JsDomContext, url: []const u8, mime_type: []const u8) void {
            if ((self.fetch_count >= MAX_FETCH_RECORDS)) {
                return;
            }
            var rec = (&self.fetch_records[@as(usize, @intCast(self.fetch_count))]);
            _ = &rec;
            const u_len = @min(url.len, rec.url_buf.len);
            _ = @memcpy(rec.url_buf[0..u_len], url[0..u_len]);
            rec.url_len = u_len;
            const m_len = @min(mime_type.len, rec.mime_buf.len);
            _ = @memcpy(rec.mime_buf[0..m_len], mime_type[0..m_len]);
            rec.mime_len = m_len;
            const f_len = @min(self.frame_id_len, rec.frame_id_buf.len);
            _ = @memcpy(rec.frame_id_buf[0..f_len], self.frame_id_buf[0..f_len]);
            rec.frame_id_len = f_len;
            const l_len = @min(self.loader_id_len, rec.loader_id_buf.len);
            _ = @memcpy(rec.loader_id_buf[0..l_len], self.loader_id_buf[0..l_len]);
            rec.loader_id_len = l_len;
            self.fetch_count = (self.fetch_count + 1);
    }

pub fn clearFetchRecords(self: *JsDomContext) void {
            self.fetch_count = 0;
    }

pub fn addConsoleRecord(self: *JsDomContext, level: []const u8, text: []const u8, args_json: []const u8) void {
            if ((self.console_count >= MAX_CONSOLE_RECORDS)) {
                var j: usize = 1;
                _ = &j;
                while ((j < MAX_CONSOLE_RECORDS)) : (j = (j + 1)) {
                    self.console_records[cp_cast_int(usize, (j - 1))] = self.console_records[@as(usize, @intCast(j))];
                }
                self.console_count = (MAX_CONSOLE_RECORDS - 1);
            }
            var rec = (&self.console_records[@as(usize, @intCast(self.console_count))]);
            _ = &rec;
            const l_len = @min(level.len, rec.level.len);
            _ = @memcpy(rec.level[0..l_len], level[0..l_len]);
            rec.level_len = l_len;
            const t_len = @min(text.len, rec.text.len);
            _ = @memcpy(rec.text[0..t_len], text[0..t_len]);
            rec.text_len = t_len;
            const a_len = @min(args_json.len, rec.args_json.len);
            _ = @memcpy(rec.args_json[0..a_len], args_json[0..a_len]);
            rec.args_json_len = a_len;
            rec.timestamp = getMilliTimestamp();
            self.console_count = (self.console_count + 1);
    }

pub fn clearConsoleRecords(self: *JsDomContext) void {
            self.console_count = 0;
    }
};

