pub fn getMilliTimestamp() i64 {
        var tv = TimeVal{ .tv_sec = 0, .tv_usec = 0 };
        _ = &tv;
        _ = gettimeofday((&tv), null);
        return ((tv.tv_sec * 1000) + @divTrunc(tv.tv_usec, 1000));
}

