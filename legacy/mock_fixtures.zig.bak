            var search = url[(q_pos + 1)..];
            _ = &search;
            if (std.mem.indexOfScalar(u8, search, 35)) |h_pos| {
                _ = &h_pos;
                search = search[0..h_pos];
            }
            var it = std.mem.splitScalar(u8, search, 38);
            _ = &it;
            while (it.next()) |part| {
                const eq_pos = ((std.mem.indexOfScalar(u8, part, 61)) orelse continue);
                const k = part[0..eq_pos];
                const v = part[(eq_pos + 1)..];
                if (std.mem.eql(u8, k, param)) {
                    return v;
                }
            }
            return null;
    }

