            _ = &out_idx;
            var in_idx: usize = 0;
            _ = &in_idx;
            while (((in_idx < src.len) and ((out_idx + 2) < dst.len))) : (in_idx = (in_idx + 1)) {
                const b = src[@as(usize, @intCast(in_idx))];
                if (((b == 34) or (b == 92))) {
                    dst[cp_cast_int(usize, out_idx)] = 92;
                    out_idx = (out_idx + 1);
                    dst[cp_cast_int(usize, out_idx)] = b;
                    out_idx = (out_idx + 1);
                } else {
                    if ((b == 10)) {
                        dst[cp_cast_int(usize, out_idx)] = 92;
                        out_idx = (out_idx + 1);
                        dst[cp_cast_int(usize, out_idx)] = 110;
                        out_idx = (out_idx + 1);
                    } else {
                        if ((b == 13)) {
                            dst[cp_cast_int(usize, out_idx)] = 92;
                            out_idx = (out_idx + 1);
                            dst[cp_cast_int(usize, out_idx)] = 114;
                            out_idx = (out_idx + 1);
                        } else {
                            dst[cp_cast_int(usize, out_idx)] = b;
                            out_idx = (out_idx + 1);
                        }
                    }
                }
            }
            return dst[0..out_idx];
    }

pub fn extractQueryParam(url: []const u8, param: []const u8) ?[]const u8 {
