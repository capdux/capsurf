pub fn isHttpTokenChar(c: u8) bool {
        if (std.ascii.isAlphanumeric(c)) {
            return true;
        }
        return (switch (c) {
'!', '#', '$', '%', '&', '\'', '*', '+', '-', '.', '^', '_', '`', '|', '~' => true,
else => false,
});
}

pub fn isValidHeaderName(name: []const u8) bool {
        if ((name.len == 0)) {
            return false;
        }
        for (cp_iter_slice(name)) |c| {
            _ = &c;
            if ((!isHttpTokenChar(c))) {
                return false;
            }
        }
        return true;
}

pub fn isValidHeaderValue(value: []const u8) bool {
        for (cp_iter_slice(value)) |c| {
            _ = &c;
            if ((((c == 0) or (c == 10)) or (c == 13))) {
                return false;
            }
        }
        return true;
}

pub fn stripHttpWhitespace(s: []const u8) []const u8 {
        return std.mem.trim(u8, s, " \t\r\n");
}
