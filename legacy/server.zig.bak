        _ = &digest;
        _ = hasher.final((&digest));
        const encoder = std.base64.standard.Encoder;
        return encoder.encode(out_buf, (&digest)).len;
}

pub fn writeWsTextFrame(client_fd: i32, text: []const u8) !void {
        var header_buf: [10]u8 = @as([10]u8, @splat(@as(u8, 0)));
        _ = &header_buf;
        header_buf[cp_cast_int(usize, 0)] = 129;
        var header_len: usize = 2;
        _ = &header_len;
        if ((text.len <= 125)) {
            header_buf[cp_cast_int(usize, 1)] = @as(u8, @truncate(text.len));
        } else {
            if ((text.len <= 65535)) {
                header_buf[cp_cast_int(usize, 1)] = 126;
                _ = std.mem.writeInt(u16, header_buf[2..4][0..2], @as(u16, @truncate(text.len)), .big);
                header_len = 4;
            } else {
                header_buf[cp_cast_int(usize, 1)] = 127;
                _ = std.mem.writeInt(u64, header_buf[2..10][0..8], (if (comptime @typeInfo(@TypeOf(text.len)) == .@"enum") cp_cast_int(u64, @intFromEnum(text.len)) else cp_cast_int(u64, text.len)), .big);
                header_len = 10;
            }
        }
        _ = try socketWriteAll(client_fd, header_buf[0..header_len]);
        _ = try socketWriteAll(client_fd, text);
}

pub fn writeWsCloseFrame(client_fd: i32, code: u16, reason: []const u8) !void {
        var buf: [128]u8 = @as([128]u8, @splat(@as(u8, 0)));
        _ = &buf;
        buf[cp_cast_int(usize, 0)] = 136;
        const payload_len = (2 + reason.len);
        buf[cp_cast_int(usize, 1)] = @as(u8, @truncate(payload_len));
        _ = std.mem.writeInt(u16, buf[2..4][0..2], code, .big);
        if ((reason.len > 0)) {
            _ = @memcpy(buf[4..(4 + reason.len)], reason);
        }
        _ = try socketWriteAll(client_fd, buf[0..(2 + payload_len)]);
}

pub fn readWsTextFrame(client_fd: i32, payload_buf: []u8) !?[]const u8 {
        var hdr: [2]u8 = @as([2]u8, @splat(@as(u8, 0)));
        _ = &hdr;
        const n = recv(client_fd, (&hdr), 2, 0);
        if ((n < 2)) {
            return null;
        }
        const b0 = hdr[0];
        const b1 = hdr[1];
        const opcode = (b0 & 15);
        if ((opcode == 8)) {
            var close_resp: [2]u8 = .{ 136, 0 };
            _ = &close_resp;
            _ = (blk_catch_20: { break :blk_catch_20 ((socketWriteAll(client_fd, (&close_resp))) catch |__ce_20| { _ = &__ce_20;  }); });
            return null;
        }
        const masked = ((b1 & 128) != 0);
        const len7 = (b1 & 127);
        var payload_len: usize = len7;
        _ = &payload_len;
        if ((len7 == 126)) {
            var ext: [2]u8 = @as([2]u8, @splat(@as(u8, 0)));
            _ = &ext;
            _ = try socketReadAll(client_fd, (&ext));
            payload_len = std.mem.readInt(u16, ext[0..2], .big);
        } else {
            if ((len7 == 127)) {
                var ext: [8]u8 = @as([8]u8, @splat(@as(u8, 0)));
                _ = &ext;
                _ = try socketReadAll(client_fd, (&ext));
                payload_len = @as(usize, @truncate(std.mem.readInt(u64, ext[0..8], .big)));
            }
        }
        if ((payload_len > payload_buf.len)) {
            return error.PayloadTooLarge;
        }
        var mask_key: [4]u8 = @as([4]u8, @splat(@as(u8, 0)));
        _ = &mask_key;
        if (masked) {
            _ = try socketReadAll(client_fd, (&mask_key));
        }
        const read_len = try socketReadAll(client_fd, payload_buf[0..payload_len]);
        if ((read_len < payload_len)) {
            return error.IncompletePayload;
        }
        if (masked) {
            var i: usize = 0;
            _ = &i;
            while ((i < payload_len)) : (i = (i + 1)) {
                payload_buf[cp_cast_int(usize, i)] = (payload_buf[@as(usize, @intCast(i))] ^ mask_key[@as(usize, @intCast((i % 4)))]);
            }
        }
        return payload_buf[0..payload_len];
}
