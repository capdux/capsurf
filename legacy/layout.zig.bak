pub fn getBoundingClientRect(self: LayoutTree, node_id: NodeId) Rect {
            if (((node_id == NULL_NODE) or ((if (comptime @typeInfo(@TypeOf(node_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(node_id)) else cp_cast_int(usize, node_id)) >= self.boxes.items.len))) {
                return Rect.zero();
            }
            return self.boxes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(node_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(node_id)) else cp_cast_int(usize, node_id))))].rect;
    }

pub fn isClickable(self: LayoutTree, node_id: NodeId) bool {
            const r = self.getBoundingClientRect(node_id);
            return r.isClickable();
    }

pub fn resolveBoxMetrics(self: *LayoutTree, doc: *const Document, node_id: NodeId, style: *const ComputedStyle, parent_w: f32, parent_h: f32) void {
            var box = (&self.boxes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(node_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(node_id)) else cp_cast_int(usize, node_id))))]);
            _ = &box;
            const font_px = style.font_size_px;
            const root_px = self.root_font_px;
            const vw = self.viewport_width;
            const vh = self.viewport_height;
            box.margin_top = style.margin_top.resolvePx(parent_w, font_px, root_px, vw, vh);
            box.margin_right = style.margin_right.resolvePx(parent_w, font_px, root_px, vw, vh);
            box.margin_bottom = style.margin_bottom.resolvePx(parent_w, font_px, root_px, vw, vh);
            box.margin_left = style.margin_left.resolvePx(parent_w, font_px, root_px, vw, vh);
            box.padding_top = style.padding_top.resolvePx(parent_w, font_px, root_px, vw, vh);
            box.padding_right = style.padding_right.resolvePx(parent_w, font_px, root_px, vw, vh);
            box.padding_bottom = style.padding_bottom.resolvePx(parent_w, font_px, root_px, vw, vh);
            box.padding_left = style.padding_left.resolvePx(parent_w, font_px, root_px, vw, vh);
            box.border_top = style.border_top_width;
            box.border_right = style.border_right_width;
            box.border_bottom = style.border_bottom_width;
            box.border_left = style.border_left_width;
            var replaced_opt: ?ReplacedSize = null;
            _ = &replaced_opt;
            if (((node_id != NULL_NODE) and ((if (comptime @typeInfo(@TypeOf(node_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(node_id)) else cp_cast_int(usize, node_id)) < doc.nodes.items.len))) {
                const node = (&doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(node_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(node_id)) else cp_cast_int(usize, node_id))))]);
                if (node.isElement()) {
                    replaced_opt = LayoutTree.getReplacedSize(node);
                }
            }
            var raw_w: f32 = 0.0;
            _ = &raw_w;
            if (((!style.width.is_auto) and (!style.width.is_none))) {
                raw_w = style.width.resolvePx(parent_w, font_px, root_px, vw, vh);
            } else {
                if (replaced_opt) |rep| {
                    _ = &rep;
                    if (rep.is_authored) {
                        raw_w = rep.width;
                    } else {
                        const avail = (parent_w - box.marginHorizontal());
                        if (((avail > 0.0) and (rep.width > avail))) {
                            raw_w = avail;
                        } else {
                            raw_w = rep.width;
                        }
                    }
                } else {
                    const avail = (parent_w - box.marginHorizontal());
                    raw_w = (if ((avail > 0.0)) avail else 0.0);
                }
            }
            if ((style.box_sizing == BoxSizing.BorderBox)) {
                const h_decor = (box.paddingHorizontal() + box.borderHorizontal());
                box.content_width = (if ((raw_w > h_decor)) (raw_w - h_decor) else 0.0);
            } else {
                box.content_width = raw_w;
            }
            if (((!style.min_width.is_auto) and (!style.min_width.is_none))) {
                const min_w = style.min_width.resolvePx(parent_w, font_px, root_px, vw, vh);
                if ((box.content_width < min_w)) {
                    box.content_width = min_w;
                }
            }
            if (((!style.max_width.is_auto) and (!style.max_width.is_none))) {
                const max_w = style.max_width.resolvePx(parent_w, font_px, root_px, vw, vh);
                if ((box.content_width > max_w)) {
                    box.content_width = max_w;
                }
            }
            if (((!style.height.is_auto) and (!style.height.is_none))) {
                const raw_h = style.height.resolvePx(parent_h, font_px, root_px, vw, vh);
                if ((style.box_sizing == BoxSizing.BorderBox)) {
                    const v_decor = (box.paddingVertical() + box.borderVertical());
                    box.content_height = (if ((raw_h > v_decor)) (raw_h - v_decor) else 0.0);
                } else {
                    box.content_height = raw_h;
                }
            } else {
                if (replaced_opt) |rep| {
                    _ = &rep;
                    if (((rep.width > 0.0) and (rep.height > 0.0))) {
                        const ratio = (rep.height / rep.width);
                        box.content_height = (box.content_width * ratio);
                    } else {
                        box.content_height = rep.height;
                    }
                } else {
                    box.content_height = 0.0;
                }
            }
            if (((!style.min_height.is_auto) and (!style.min_height.is_none))) {
                const min_h = style.min_height.resolvePx(parent_h, font_px, root_px, vw, vh);
                if ((box.content_height < min_h)) {
                    box.content_height = min_h;
                }
            }
            if (((!style.max_height.is_auto) and (!style.max_height.is_none))) {
                const max_h = style.max_height.resolvePx(parent_h, font_px, root_px, vw, vh);
                if ((box.content_height > max_h)) {
                    box.content_height = max_h;
                }
            }
    }

pub fn layoutNode(self: *LayoutTree, doc: *const Document, styles: []const ComputedStyle, node_id: NodeId, origin_x: f32, origin_y: f32, avail_w: f32, avail_h: f32) void {
            if (((node_id == NULL_NODE) or ((if (comptime @typeInfo(@TypeOf(node_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(node_id)) else cp_cast_int(usize, node_id)) >= self.boxes.items.len))) {
                return;
            }
            const style = (&styles[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(node_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(node_id)) else cp_cast_int(usize, node_id))))]);
            if (style.display.isNone()) {
                self.boxes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(node_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(node_id)) else cp_cast_int(usize, node_id))))].rect = Rect.zero();
                return;
            }
            _ = self.resolveBoxMetrics(doc, node_id, style, avail_w, avail_h);
            const box = (&self.boxes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(node_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(node_id)) else cp_cast_int(usize, node_id))))]);
            const border_box_x = (origin_x + box.margin_left);
            const border_box_y = (origin_y + box.margin_top);
            const content_x = ((border_box_x + box.border_left) + box.padding_left);
            const content_y = ((border_box_y + box.border_top) + box.padding_top);
            var is_replaced = false;
            _ = &is_replaced;
            if (((node_id != NULL_NODE) and ((if (comptime @typeInfo(@TypeOf(node_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(node_id)) else cp_cast_int(usize, node_id)) < doc.nodes.items.len))) {
                const node = (&doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(node_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(node_id)) else cp_cast_int(usize, node_id))))]);
                if ((node.isElement() and (LayoutTree.getReplacedSize(node) != null))) {
                    is_replaced = true;
                }
            }
            if (style.display.isFlex()) {
                _ = self.layoutFlexContainer(doc, styles, node_id, content_x, content_y);
            } else {
                if ((!is_replaced)) {
                    _ = self.layoutBlockContainer(doc, styles, node_id, content_x, content_y);
                }
            }
            var box_after = (&self.boxes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(node_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(node_id)) else cp_cast_int(usize, node_id))))]);
            _ = &box_after;
            const text_len = LayoutTree.getNodeTextLength(doc, node_id);
            if ((text_len > 0)) {
                if ((style.height.is_auto and (box_after.content_height <= 0.0))) {
                    const font_h = (if ((style.font_size_px > 0.0)) style.font_size_px else 16.0);
                    box_after.content_height = font_h;
                }
                if ((style.width.is_auto and (box_after.content_width <= 0.0))) {
                    const char_w: f32 = 8.0;
                    box_after.content_width = (@as(f32, @floatFromInt(text_len)) * char_w);
                }
            }
            const final_box = (&self.boxes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(node_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(node_id)) else cp_cast_int(usize, node_id))))]);
            const final_w = final_box.borderBoxWidth();
            const final_h = final_box.borderBoxHeight();
            var pos_offset_x: f32 = 0.0;
            _ = &pos_offset_x;
            var pos_offset_y: f32 = 0.0;
            _ = &pos_offset_y;
            var rect_x = border_box_x;
            _ = &rect_x;
            var rect_y = border_box_y;
            _ = &rect_y;
            if ((style.position == Position.Relative)) {
                if (((!style.left.is_auto) and (!style.left.is_none))) {
                    pos_offset_x = style.left.resolvePx(avail_w, style.font_size_px, self.root_font_px, self.viewport_width, self.viewport_height);
                } else {
                    if (((!style.right.is_auto) and (!style.right.is_none))) {
                        const r_px = style.right.resolvePx(avail_w, style.font_size_px, self.root_font_px, self.viewport_width, self.viewport_height);
                        pos_offset_x = (0.0 - r_px);
                    }
                }
                if (((!style.top.is_auto) and (!style.top.is_none))) {
                    pos_offset_y = style.top.resolvePx(avail_h, style.font_size_px, self.root_font_px, self.viewport_width, self.viewport_height);
                } else {
                    if (((!style.bottom.is_auto) and (!style.bottom.is_none))) {
                        const b_px = style.bottom.resolvePx(avail_h, style.font_size_px, self.root_font_px, self.viewport_width, self.viewport_height);
                        pos_offset_y = (0.0 - b_px);
                    }
                }
                rect_x = (rect_x + pos_offset_x);
                rect_y = (rect_y + pos_offset_y);
            } else {
                if (((style.position == Position.Absolute) or (style.position == Position.Fixed))) {
                    if (((!style.left.is_auto) and (!style.left.is_none))) {
                        rect_x = style.left.resolvePx(avail_w, style.font_size_px, self.root_font_px, self.viewport_width, self.viewport_height);
                    } else {
                        if (((!style.right.is_auto) and (!style.right.is_none))) {
                            const r_px = style.right.resolvePx(avail_w, style.font_size_px, self.root_font_px, self.viewport_width, self.viewport_height);
                            rect_x = ((avail_w - r_px) - final_w);
                        }
                    }
                    if (((!style.top.is_auto) and (!style.top.is_none))) {
                        rect_y = style.top.resolvePx(avail_h, style.font_size_px, self.root_font_px, self.viewport_width, self.viewport_height);
                    } else {
                        if (((!style.bottom.is_auto) and (!style.bottom.is_none))) {
                            const b_px = style.bottom.resolvePx(avail_h, style.font_size_px, self.root_font_px, self.viewport_width, self.viewport_height);
                            rect_y = ((avail_h - b_px) - final_h);
                        }
                    }
                }
            }
            const is_visible = (style.visibility == Visibility.Visible);
            self.boxes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(node_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(node_id)) else cp_cast_int(usize, node_id))))].rect = Rect{ .x = rect_x, .y = rect_y, .width = final_w, .height = final_h, .visible = is_visible };
    }

pub fn layoutBlockContainer(self: *LayoutTree, doc: *const Document, styles: []const ComputedStyle, parent_id: NodeId, content_x: f32, content_y: f32) void {
            const parent_box = (&self.boxes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(parent_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(parent_id)) else cp_cast_int(usize, parent_id))))]);
            const content_w = parent_box.content_width;
            var cursor_y = content_y;
            _ = &cursor_y;
            var max_child_right = content_x;
            _ = &max_child_right;
            var child = doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(parent_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(parent_id)) else cp_cast_int(usize, parent_id))))].first_child;
            _ = &child;
            while ((child != NULL_NODE)) {
                const cnode = (&doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(child)) == .@"enum") cp_cast_int(usize, @intFromEnum(child)) else cp_cast_int(usize, child))))]);
                if ((cnode.node_type == NodeType.Element)) {
                    const cstyle = (&styles[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(child)) == .@"enum") cp_cast_int(usize, @intFromEnum(child)) else cp_cast_int(usize, child))))]);
                    if ((!cstyle.display.isNone())) {
                        var child_x = content_x;
                        _ = &child_x;
                        const prev_id = cnode.prev_sibling;
                        if (((prev_id != NULL_NODE) and ((if (comptime @typeInfo(@TypeOf(prev_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(prev_id)) else cp_cast_int(usize, prev_id)) < doc.nodes.items.len))) {
                            const prev_node = (&doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(prev_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(prev_id)) else cp_cast_int(usize, prev_id))))]);
                            if (((prev_node.node_type == .Text) and (prev_node.text_content.len > 0))) {
                                child_x = (child_x + (@as(f32, @floatFromInt(prev_node.text_content.len)) * 8.0));
                            }
                        }
                        _ = self.layoutNode(doc, styles, child, child_x, cursor_y, content_w, 0.0);
                        const cbox = (&self.boxes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(child)) == .@"enum") cp_cast_int(usize, @intFromEnum(child)) else cp_cast_int(usize, child))))]);
                        cursor_y = (cursor_y + cbox.outerHeight());
                        const cr = cbox.rect.right();
                        if ((cr > max_child_right)) {
                            max_child_right = cr;
                        }
                    } else {
                        self.boxes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(child)) == .@"enum") cp_cast_int(usize, @intFromEnum(child)) else cp_cast_int(usize, child))))].rect = Rect.zero();
                    }
                }
                child = cnode.next_sibling;
            }
            if (styles[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(parent_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(parent_id)) else cp_cast_int(usize, parent_id))))].height.is_auto) {
                var is_p_rep = false;
                _ = &is_p_rep;
                if (((parent_id != NULL_NODE) and ((if (comptime @typeInfo(@TypeOf(parent_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(parent_id)) else cp_cast_int(usize, parent_id)) < doc.nodes.items.len))) {
                    const pnode = (&doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(parent_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(parent_id)) else cp_cast_int(usize, parent_id))))]);
                    if ((pnode.isElement() and (LayoutTree.getReplacedSize(pnode) != null))) {
                        is_p_rep = true;
                    }
                }
                if ((!is_p_rep)) {
                    const auto_h = (cursor_y - content_y);
                    self.boxes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(parent_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(parent_id)) else cp_cast_int(usize, parent_id))))].content_height = (if ((auto_h > 0.0)) auto_h else 0.0);
                }
            }
    }

pub fn layoutFlexContainer(self: *LayoutTree, doc: *const Document, styles: []const ComputedStyle, parent_id: NodeId, content_x: f32, content_y: f32) void {
            const pstyle = (&styles[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(parent_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(parent_id)) else cp_cast_int(usize, parent_id))))]);
            const pbox = (&self.boxes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(parent_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(parent_id)) else cp_cast_int(usize, parent_id))))]);
            const container_w = pbox.content_width;
            const container_h = pbox.content_height;
            const is_row = pstyle.flex_direction.isRow();
            const main_size = (if (is_row) container_w else container_h);
            const cross_size = (if (is_row) container_h else container_w);
            const gap = (if (is_row) pstyle.column_gap else pstyle.row_gap);
            var items: [32]FlexItem = @as([32]FlexItem, @splat(@as(FlexItem, FlexItem{  })));
            _ = &items;
            var item_count: usize = 0;
            _ = &item_count;
            var child = doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(parent_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(parent_id)) else cp_cast_int(usize, parent_id))))].first_child;
            _ = &child;
            while (((child != NULL_NODE) and (item_count < 32))) {
                const cnode = (&doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(child)) == .@"enum") cp_cast_int(usize, @intFromEnum(child)) else cp_cast_int(usize, child))))]);
                if ((cnode.node_type == NodeType.Element)) {
                    const cstyle = (&styles[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(child)) == .@"enum") cp_cast_int(usize, @intFromEnum(child)) else cp_cast_int(usize, child))))]);
                    if ((!cstyle.display.isNone())) {
                        _ = self.resolveBoxMetrics(doc, child, cstyle, container_w, container_h);
                        const cbox = (&self.boxes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(child)) == .@"enum") cp_cast_int(usize, @intFromEnum(child)) else cp_cast_int(usize, child))))]);
                        var base_m: f32 = 0.0;
                        _ = &base_m;
                        var base_c: f32 = 0.0;
                        _ = &base_c;
                        if (is_row) {
                            if ((!cstyle.flex_basis.is_auto)) {
                                base_m = cstyle.flex_basis.resolvePx(container_w, cstyle.font_size_px, self.root_font_px, self.viewport_width, self.viewport_height);
                            } else {
                                if ((!cstyle.width.is_auto)) {
                                    base_m = cbox.borderBoxWidth();
                                } else {
                                    base_m = 0.0;
                                }
                            }
                            base_c = cbox.borderBoxHeight();
                        } else {
                            if ((!cstyle.flex_basis.is_auto)) {
                                base_m = cstyle.flex_basis.resolvePx(container_h, cstyle.font_size_px, self.root_font_px, self.viewport_width, self.viewport_height);
                            } else {
                                if ((!cstyle.height.is_auto)) {
                                    base_m = cbox.borderBoxHeight();
                                } else {
                                    base_m = 0.0;
                                }
                            }
                            base_c = cbox.borderBoxWidth();
                        }
                        items[cp_cast_int(usize, item_count)] = FlexItem{ .node_id = child, .base_main = base_m, .base_cross = base_c, .target_main = base_m, .target_cross = base_c, .grow = cstyle.flex_grow, .shrink = cstyle.flex_shrink };
                        item_count = (item_count + 1);
                    } else {
                        self.boxes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(child)) == .@"enum") cp_cast_int(usize, @intFromEnum(child)) else cp_cast_int(usize, child))))].rect = Rect.zero();
                    }
                }
                child = cnode.next_sibling;
            }
            if ((item_count == 0)) {
                return;
            }
            var total_base_main: f32 = 0.0;
            _ = &total_base_main;
            var total_grow: f32 = 0.0;
            _ = &total_grow;
            var total_shrink: f32 = 0.0;
            _ = &total_shrink;
            var idx: usize = 0;
            _ = &idx;
            while ((idx < item_count)) : (idx = (idx + 1)) {
                total_base_main = (total_base_main + items[@as(usize, @intCast(idx))].base_main);
                total_grow = (total_grow + items[@as(usize, @intCast(idx))].grow);
                total_shrink = (total_shrink + items[@as(usize, @intCast(idx))].shrink);
            }
            const gaps_count_f: f32 = @floatFromInt((item_count - 1));
            const total_gaps: f32 = (gaps_count_f * gap);
            const free_space = ((main_size - total_base_main) - total_gaps);
            if (((free_space > 0.0) and (total_grow > 0.0))) {
                var i: usize = 0;
                _ = &i;
                while ((i < item_count)) : (i = (i + 1)) {
                    const ratio = (items[@as(usize, @intCast(i))].grow / total_grow);
                    items[@as(usize, @intCast(i))].target_main = (items[@as(usize, @intCast(i))].base_main + (free_space * ratio));
                }
            } else {
                if (((free_space < 0.0) and (total_shrink > 0.0))) {
                    var i: usize = 0;
                    _ = &i;
                    while ((i < item_count)) : (i = (i + 1)) {
                        const ratio = (items[@as(usize, @intCast(i))].shrink / total_shrink);
                        const shrunk = (items[@as(usize, @intCast(i))].base_main + (free_space * ratio));
                        items[@as(usize, @intCast(i))].target_main = (if ((shrunk > 0.0)) shrunk else 0.0);
                    }
                }
            }
            var used_main: f32 = total_gaps;
            _ = &used_main;
            var j: usize = 0;
            _ = &j;
            while ((j < item_count)) : (j = (j + 1)) {
                used_main = (used_main + items[@as(usize, @intCast(j))].target_main);
            }
            const remaining_main = (if ((main_size > used_main)) (main_size - used_main) else 0.0);
            const count_f: f32 = @floatFromInt(item_count);
            const count_plus_1: f32 = @floatFromInt((item_count + 1));
            var count_minus_1: f32 = 1.0;
            _ = &count_minus_1;
            if ((item_count > 1)) {
                count_minus_1 = @floatFromInt((item_count - 1));
            }
            const start_offset: f32 = (switch (pstyle.justify_content) {
.FlexStart => 0.0,
.FlexEnd => remaining_main,
.Center => (remaining_main / 2.0),
.SpaceAround => ((remaining_main / count_f) / 2.0),
.SpaceEvenly => (remaining_main / count_plus_1),
.SpaceBetween => 0.0,
});
            var space_between_step = gap;
            _ = &space_between_step;
            if ((item_count > 1)) {
                space_between_step = (gap + (remaining_main / count_minus_1));
            }
            const between_step: f32 = (switch (pstyle.justify_content) {
.SpaceBetween => space_between_step,
.SpaceAround => (gap + (remaining_main / count_f)),
.SpaceEvenly => (gap + (remaining_main / count_plus_1)),
else => gap,
});
            var current_main = start_offset;
            _ = &current_main;
            var max_item_cross: f32 = 0.0;
            _ = &max_item_cross;
            var k: usize = 0;
            _ = &k;
            while ((k < item_count)) : (k = (k + 1)) {
                var itm = (&items[@as(usize, @intCast(k))]);
                _ = &itm;
                const cid = itm.node_id;
                const cbox = (&self.boxes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(cid)) == .@"enum") cp_cast_int(usize, @intFromEnum(cid)) else cp_cast_int(usize, cid))))]);
                const cross_item_size = (if (is_row) cbox.borderBoxHeight() else cbox.borderBoxWidth());
                var cross_pos: f32 = 0.0;
                _ = &cross_pos;
                if ((cross_size > cross_item_size)) {
                    if ((pstyle.align_items == .FlexEnd)) {
                        cross_pos = (cross_size - cross_item_size);
                    } else {
                        if ((pstyle.align_items == .Center)) {
                            cross_pos = ((cross_size - cross_item_size) / 2.0);
                        }
                    }
                }
                if (((pstyle.align_items == .Stretch) and (cross_size > 0.0))) {
                    itm.target_cross = cross_size;
                }
                const item_x = (if (is_row) (content_x + current_main) else (content_x + cross_pos));
                const item_y = (if (is_row) (content_y + cross_pos) else (content_y + current_main));
                if (is_row) {
                    const h_decor = (cbox.paddingHorizontal() + cbox.borderHorizontal());
                    self.boxes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(cid)) == .@"enum") cp_cast_int(usize, @intFromEnum(cid)) else cp_cast_int(usize, cid))))].content_width = (if ((itm.target_main > h_decor)) (itm.target_main - h_decor) else 0.0);
                } else {
                    const v_decor = (cbox.paddingVertical() + cbox.borderVertical());
                    self.boxes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(cid)) == .@"enum") cp_cast_int(usize, @intFromEnum(cid)) else cp_cast_int(usize, cid))))].content_height = (if ((itm.target_main > v_decor)) (itm.target_main - v_decor) else 0.0);
                }
                _ = self.layoutNode(doc, styles, cid, item_x, item_y, itm.target_main, itm.target_cross);
                const rendered_cross = (if (is_row) self.boxes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(cid)) == .@"enum") cp_cast_int(usize, @intFromEnum(cid)) else cp_cast_int(usize, cid))))].borderBoxHeight() else self.boxes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(cid)) == .@"enum") cp_cast_int(usize, @intFromEnum(cid)) else cp_cast_int(usize, cid))))].borderBoxWidth());
                if ((rendered_cross > max_item_cross)) {
                    max_item_cross = rendered_cross;
                }
                current_main = (current_main + (itm.target_main + between_step));
            }
            if (is_row) {
                if (styles[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(parent_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(parent_id)) else cp_cast_int(usize, parent_id))))].height.is_auto) {
                    self.boxes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(parent_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(parent_id)) else cp_cast_int(usize, parent_id))))].content_height = max_item_cross;
                }
            } else {
                if (styles[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(parent_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(parent_id)) else cp_cast_int(usize, parent_id))))].width.is_auto) {
                    self.boxes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(parent_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(parent_id)) else cp_cast_int(usize, parent_id))))].content_width = max_item_cross;
                }
            }
    }

pub fn computeLayout(self: *LayoutTree, doc: *const Document, styles: []const ComputedStyle) !void {
            const total = doc.nodes.items.len;
            _ = self.boxes.clearRetainingCapacity();
            var i: usize = 0;
            _ = &i;
            while ((i < total)) : (i = (i + 1)) {
                _ = try self.boxes.append(self.allocator, LayoutBox{ .node_id = @intCast(i) });
            }
            if ((doc.root_element != NULL_NODE)) {
                _ = self.layoutNode(doc, styles, doc.root_element, 0.0, 0.0, self.viewport_width, self.viewport_height);
            }
    }
};

