pub fn printUsage() void {
        _ = std.debug.print(((((((((((("CapSurf: Million-Agent Native Headless Browser in CP\n\n" ++ "Usage: capsurf [options] [url]\n\n") ++ "Options:\n") ++ "  --remote-debugging-port=<port>     Set CDP remote debugging port (default: 9222)\n") ++ "  --remote-debugging-address=<ip>    Set listen address (default: 127.0.0.1)\n") ++ "  --window-size=<width>,<height>     Set viewport resolution (default: 1280,720)\n") ++ "  --user-data-dir=<dir>              Set profile directory path\n") ++ "  --headless                         Run in headless mode (default: true)\n") ++ "  --no-sandbox, --disable-gpu        Standard Chromium flags (gracefully accepted)\n") ++ "  --demo                             Run built-in multi-milestone self-check demo\n") ++ "  -v, --version                      Print CapSurf engine version\n") ++ "  -h, --help                         Show this help message\n\n"), .{});
}

pub fn runDemo() void {
        _ = std.debug.print("==================================================================\n", .{});
        _ = std.debug.print(" CapSurf: Million-Agent Native Headless Browser in CP (Self-Check)\n", .{});
        _ = std.debug.print("==================================================================\n", .{});
        _ = std.debug.print("[Milestone 1] Arena DOM (u32) + cap:css Selectors + 64-bit Cascade + Layout\n", .{});
        _ = std.debug.print("[Milestone 2] HTML5 Tokenizer (80 states) + TreeBuilder (AAA, Foster)\n", .{});
        _ = std.debug.print("[Milestone 3] QuickJS-NG Engine Binding + DOM API Mounting + Preemption\n", .{});
        _ = std.debug.print("[Milestone 4] CDP Protocol Server + AXTree Semantics + WebMCP Tool Reflection\n", .{});
        var doc = ((Document.init(std.heap.page_allocator)) catch unreachable);
        _ = &doc;
        defer {
        _ = doc.deinit();
        }
        const sample_html = (((((("<!DOCTYPE html>" ++ "<html><head><title>CapSurf Demo</title></head>") ++ "<body>") ++ "  <div id=\"app\" style=\"display: flex; width: 600px; height: 100px; padding: 10px;\">") ++ "    <button id=\"btn-run\" class=\"btn action\" style=\"width: 120px; height: 40px;\">Launch Agent</button>") ++ "  </div>") ++ "</body></html>");
        _ = ((doc.parseHtml(sample_html)) catch unreachable);
        const btn = doc.getElementById("btn-run");
        const q_title = Matcher.querySelector(doc, "head > title");
        const title_text = doc.getTextContent(doc.getFirstChild(q_title));
        _ = std.debug.print("[Demo Parsed] Page Title: \"{s}\", Target Button NodeId: {}\n", .{ title_text, btn });
        const css_text = (("* { box-sizing: border-box; margin: 0; padding: 0; }\n" ++ "#app { display: flex; flex-direction: row; padding: 10px; width: 600px; height: 100px; }\n") ++ "#btn-run { width: 120px; height: 40px; }\n");
        const sheet = StyleSheet.parse(css_text, 800.0, false);
        var styles: [16]ComputedStyle = @as([16]ComputedStyle, @splat(@as(ComputedStyle, ComputedStyle{  })));
        _ = &styles;
        _ = Cascade.computeStyles(doc, sheet, styles[0..doc.nodeCount()], 16.0);
        var layout = ((LayoutTree.init(std.heap.page_allocator, 800.0, 600.0)) catch unreachable);
        _ = &layout;
        defer {
        _ = layout.deinit();
        }
        _ = ((layout.computeLayout(doc, styles[0..doc.nodeCount()])) catch unreachable);
        const btn_rect = layout.getBoundingClientRect(btn);
        _ = std.debug.print("[Demo Layout] Button Screen Rect: x={d:.1}, y={d:.1}, w={d:.1}, h={d:.1}, visible={}\n", .{ btn_rect.x, btn_rect.y, btn_rect.width, btn_rect.height, btn_rect.visible });
        var rt = ((JsRuntime.init(((32 * 1024) * 1024), 100000)) catch unreachable);
        _ = &rt;
        defer {
        _ = rt.deinit();
        }
        var ctx = ((rt.createContext()) catch unreachable);
        _ = &ctx;
        defer {
        _ = ctx.deinit();
        }
        _ = ((mountDom(ctx, doc, layout)) catch unreachable);
        const js_demo = ((((("console.log('[JS Log] Hello from QuickJS inside CapSurf!');\n" ++ "const btn = document.getElementById('btn-run');\n") ++ "const r = btn.getBoundingClientRect();\n") ++ "console.log('[JS Log] Button Rect via JS getBoundingClientRect():', r.width + 'x' + r.height + '@' + r.left + ',' + r.top);\n") ++ "btn.setAttribute('data-agent-active', 'true');\n") ++ "console.log('[JS Log] Set data-agent-active =', btn.getAttribute('data-agent-active'));\n");
        const demo_val = ctx.eval(js_demo);
        defer {
        _ = ctx.freeValue(demo_val);
        }
        _ = std.debug.print("Status: Self-Check Complete (100% Native Evaluated).\n", .{});
}
const cp_main_Context = struct { pc: u32 = 0, _self: PID = undefined, _parent: ?*anyopaque = null, _parent_fn: ?*const fn(*anyopaque) anyerror!void = null, arena: ?*std.heap.ArenaAllocator = null, received_msg: ?Message = null, received_sender: ?PID = null, await_result: ?Message = null,
    opts: *anyopaque = undefined,
    server: *anyopaque = undefined,
};

pub fn cp_main_init(arena: *std.heap.ArenaAllocator, parent: ?*anyopaque, parent_fn: ?*const fn(*anyopaque) anyerror!void) *cp_main_Context {
    const ctx = arena.allocator().create(cp_main_Context) catch unreachable;
    ctx.* = undefined; ctx.pc = 0; ctx._self = PID{ .node_id = current_node_id, .local_id = next_local_id }; next_local_id += 1; ctx.received_msg = null; ctx.received_sender = null; ctx.arena = arena; ctx._parent = parent; ctx._parent_fn = parent_fn;
    return ctx;
}


pub fn cp_main(ptr: *anyopaque) anyerror!void {
    const ctx: *cp_main_Context = @ptrCast(@alignCast(ptr));
    while (true) { switch (ctx.pc) {
0 => {
    ctx.opts = CliOptions.parseFromProcess();
    if (ctx.opts.show_help) {
        _ = printUsage();
        return;
    }
    if (ctx.opts.show_version) {
        _ = std.debug.print("CapSurf 1.0.0 (Native CP, Million-Agent Headless Engine)\n", .{});
        return;
    }
    if (ctx.opts.is_demo) {
        _ = runDemo();
        return;
    }
    ctx.server = (blk_catch_7: { break :blk_catch_7 ((CdpServer.init(std.heap.page_allocator, ctx.opts.port)) catch |e| { _ = &e; _ = std.debug.print("[CapSurf Error] Failed to initialize CDP server on port {d}: {any}\n", .{ ctx.opts.port, e });
    return; }); });
    defer {
    _ = ctx.server.deinit();
    }
    ctx.server.session.viewport_width = @as(f32, @floatFromInt(ctx.opts.window_width));
    ctx.server.session.viewport_height = @as(f32, @floatFromInt(ctx.opts.window_height));
    _ = (blk_catch_8: { break :blk_catch_8 ((ctx.server.start()) catch |e| { _ = &e; _ = std.debug.print("[CapSurf Error] Failed to bind/start server on port {d}: {any}\n", .{ ctx.opts.port, e });
    return; }); });
    _ = std.debug.print("DevTools listening on ws://{s}:{d}/devtools/browser/capsurf-browser-001\n", .{ ctx.opts.address, ctx.opts.port });
    _ = (blk_catch_9: { break :blk_catch_9 ((ctx.server.runAcceptLoop()) catch |__ce_9| { _ = &__ce_9;  }); });
    return;
},
        else => return,
    } }
}

