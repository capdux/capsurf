                    const closing_name = self.input[tag_start..tag_end];
                    if (std.ascii.eqlIgnoreCase(closing_name, self.last_start_name)) {
                        self.pos = (self.pos + 2);
                        self.current_tag = TagToken{ .kind = TagKind.End, .self_closing = false };
                        self.state = State.TagName;
                        continue;
                    }
                }
                if ((self.input[@as(usize, @intCast(self.pos))] == 38)) {
                    if (decodeEntity(self.input[self.pos..], false)) |ent| {
                        _ = &ent;
                        self.pos = (self.pos + ent.bytes_consumed);
                        const written = ent.toUtf8(self.entity_buf[0..8]);
                        return Token{ .Characters = self.entity_buf[0..written] };
                    }
                }
                const start = self.pos;
                while ((self.pos < self.input.len)) : (self.pos = (self.pos + 1)) {
                    const c = self.input[@as(usize, @intCast(self.pos))];
                    if (((c == 60) or (c == 38))) {
                        break;
                    }
                }
                if ((self.pos > start)) {
                    return Token{ .Characters = self.input[start..self.pos] };
                }
},
.PlainText => {
const text = self.input[self.pos..];
                self.pos = self.input.len;
                return Token{ .Characters = text };
},
.Comment => {
const start = self.pos;
                while (((self.pos + 2) < self.input.len)) : (self.pos = (self.pos + 1)) {
                    if ((((self.input[@as(usize, @intCast(self.pos))] == 45) and (self.input[@as(usize, @intCast((self.pos + 1)))] == 45)) and (self.input[@as(usize, @intCast((self.pos + 2)))] == 62))) {
                        const comment_text = self.input[start..self.pos];
                        self.pos = (self.pos + 3);
                        self.state = State.Data;
                        return Token{ .Comment = comment_text };
                    }
                }
                const comment_text = self.input[start..];
                self.pos = self.input.len;
                self.state = State.Data;
                return Token{ .Comment = comment_text };
},
.BogusComment => {
const start = self.pos;
                while (((self.pos < self.input.len) and (self.input[@as(usize, @intCast(self.pos))] != 62))) : (self.pos = (self.pos + 1)) {
                }
                const comment_text = self.input[start..self.pos];
                if (((self.pos < self.input.len) and (self.input[@as(usize, @intCast(self.pos))] == 62))) {
                    self.pos = (self.pos + 1);
                }
                self.state = State.Data;
                return Token{ .Comment = comment_text };
},
.Doctype => {
_ = self.skipWhitespace();
                const name_start = self.pos;
                while ((self.pos < self.input.len)) : (self.pos = (self.pos + 1)) {
                    const c = self.input[@as(usize, @intCast(self.pos))];
                    if ((((((c == 32) or (c == 9)) or (c == 13)) or (c == 10)) or (c == 62))) {
                        break;
                    }
                }
                const doc_name = self.input[name_start..self.pos];
                while (((self.pos < self.input.len) and (self.input[@as(usize, @intCast(self.pos))] != 62))) : (self.pos = (self.pos + 1)) {
                }
                if (((self.pos < self.input.len) and (self.input[@as(usize, @intCast(self.pos))] == 62))) {
                    self.pos = (self.pos + 1);
                }
                self.state = State.Data;
                return Token{ .Doctype = DoctypeToken{ .name = doc_name, .force_quirks = false } };
},
else => {
self.state = State.Data;
},
}
            }
            if ((!self.eof_emitted)) {
                self.eof_emitted = true;
                return Token{ .Eof = true };
            }
            return null;
    }

pub fn skipWhitespace(self: *Tokenizer) void {
            while ((self.pos < self.input.len)) {
                const ch = self.input[@as(usize, @intCast(self.pos))];
                if (((((ch == 32) or (ch == 9)) or (ch == 13)) or (ch == 10))) {
                    self.pos = (self.pos + 1);
                } else {
                    break;
                }
            }
    }
};

