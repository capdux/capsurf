pub const Color = CssColor;
pub const PaintStyle = ResolvedPaintStyle;

pub fn paintNodeRecursive(canvas: *Canvas, doc: *const Document, styles: []const ComputedStyle, rects: []const Rect, node_id: NodeId, vw: f32, vh: f32, opts: *const ScreenshotOptions) void {
        if (((node_id == NULL_NODE) or ((if (comptime @typeInfo(@TypeOf(node_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(node_id)) else cp_cast_int(usize, node_id)) >= doc.nodes.items.len))) {
            return;
