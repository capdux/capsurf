        const r = rects[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(node_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(node_id)) else cp_cast_int(usize, node_id))))];
        if ((!r.visible)) {
            return;
        }
        const node = (&doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(node_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(node_id)) else cp_cast_int(usize, node_id))))]);
        const style = (&styles[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(node_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(node_id)) else cp_cast_int(usize, node_id))))]);
        const paint_style = style.extractPaintStyle(r.width, 16.0, vw, vh);
        if ((node.node_type == NodeType.Element)) {
            _ = canvas.paintBox(r, paint_style);
            var display_text = node.text_content;
            _ = &display_text;
            const tag = node.tag_name;
            const is_input = (std.mem.eql(u8, tag, "input") or std.mem.eql(u8, tag, "textarea"));
            if (((display_text.len == 0) and is_input)) {
                const val: []const u8 = ((node.getAttribute("value")) orelse (""));
                display_text = val;
            }
            if ((display_text.len > 0)) {
                const pad_l = style.padding_left.resolvePx(r.width, style.font_size_px, 16.0, vw, vh);
                const pad_t = style.padding_top.resolvePx(r.height, style.font_size_px, 16.0, vw, vh);
                _ = canvas.drawText(((r.x + pad_l) + 2.0), ((r.y + pad_t) + 2.0), display_text, paint_style.text_color);
            }
            if (((node_id == opts.focused_node) and is_input)) {
                const pad_l = style.padding_left.resolvePx(r.width, style.font_size_px, 16.0, vw, vh);
                const pad_t = style.padding_top.resolvePx(r.height, style.font_size_px, 16.0, vw, vh);
                const caret_x = (@as(i32, @intFromFloat(((r.x + pad_l) + 2.0))) + @as(i32, @intCast((@min(opts.caret_pos, display_text.len) * 8))));
                const caret_y = @as(i32, @intFromFloat(((r.y + pad_t) + 2.0)));
                var cy: i32 = (caret_y + 1);
                _ = &cy;
                while ((cy <= (caret_y + 9))) : (cy = (cy + 1)) {
                    _ = canvas.blendPixel(caret_x, cy, paint_style.text_color);
                    _ = canvas.blendPixel((caret_x + 1), cy, paint_style.text_color);
                }
            }
        } else {
            if (((node.node_type == NodeType.Text) and (node.text_content.len > 0))) {
                const parent_id = node.parent;
                const parent_color = (if ((parent_id != NULL_NODE)) styles[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(parent_id)) == .@"enum") cp_cast_int(usize, @intFromEnum(parent_id)) else cp_cast_int(usize, parent_id))))].color else CssColor.rgb(0, 0, 0));
                _ = canvas.drawText((r.x + 2.0), (r.y + 2.0), node.text_content, parent_color);
            }
        }
        var child = node.first_child;
        _ = &child;
        while ((child != NULL_NODE)) {
            _ = paintNodeRecursive(canvas, doc, styles, rects, child, vw, vh, opts);
            child = doc.nodes.items[@as(usize, @intCast((if (comptime @typeInfo(@TypeOf(child)) == .@"enum") cp_cast_int(usize, @intFromEnum(child)) else cp_cast_int(usize, child))))].next_sibling;
        }
}

pub fn renderDocumentToPng(allocator: std.mem.Allocator, doc: *const Document, styles: []const ComputedStyle, rects: []const Rect, opts: ScreenshotOptions) ![]u8 {
        var canvas = try Canvas.init(allocator, opts.viewport_w, opts.viewport_h, opts.clear_color);
        _ = &canvas;
        defer {
        _ = canvas.deinit();
        }
        const vw: f32 = @floatFromInt(opts.viewport_w);
        const vh: f32 = @floatFromInt(opts.viewport_h);
        if ((doc.nodes.items.len > 1)) {
            _ = paintNodeRecursive((&canvas), doc, styles, rects, 1, vw, vh, (&opts));
        }
        return encodeCanvasToPngWithLevel(allocator, (&canvas), opts.compress_level);
}

pub fn encodeCanvasToPngWithLevel(allocator: std.mem.Allocator, canvas: *const Canvas, compress_level: u8) ![]u8 {
        const raw = PngCodec.encodeRgbaWithLevel(canvas.pixels, canvas.width, canvas.height, compress_level);
        if ((raw.len == 0)) {
            return error.EncodeFailed;
        }
        var res = try allocator.alloc(u8, raw.len);
        _ = &res;
        _ = @memcpy(res, raw);
        return res;
}

pub fn getAsciiGlyph8x8(ch: u8) []const u8 {
        return (switch (ch) {
'A', 'a' => "\x18\x3C\x66\x66\x7E\x66\x66\x00",
'B', 'b' => "\x7C\x66\x66\x7C\x66\x66\x7C\x00",
'C', 'c' => "\x3C\x66\x60\x60\x60\x66\x3C\x00",
48...57 => "\x3C\x66\x6E\x76\x66\x66\x3C\x00",
else => "\x7E\x42\x42\x7E\x42\x42\x7E\x00",
});
}
