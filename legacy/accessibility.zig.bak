                if (self_no_box) {
                    return ax_idx;
                }
                var child_id = node.first_child;
                _ = &child_id;
                while ((child_id != NULL_NODE)) {
                    if (doc.getNode(child_id)) |c_node| {
                        _ = &c_node;
