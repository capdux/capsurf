                const is_table = (std.ascii.eqlIgnoreCase(node.tag_name, "table") and (explicit_role == null));
                const starts_layout_table = (is_table and isLayoutTable(doc, dom_id));
                const in_layout_table = (if (is_table) starts_layout_table else inh_layout_table);
                const demoted_by_table = (starts_layout_table or ((inh_layout_table and isTablePart(node.tag_name)) and (explicit_role == null)));
