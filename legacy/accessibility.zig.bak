        return ((((((((std.ascii.eqlIgnoreCase(tag, "caption") or std.ascii.eqlIgnoreCase(tag, "thead")) or std.ascii.eqlIgnoreCase(tag, "tbody")) or std.ascii.eqlIgnoreCase(tag, "tfoot")) or std.ascii.eqlIgnoreCase(tag, "tr")) or std.ascii.eqlIgnoreCase(tag, "th")) or std.ascii.eqlIgnoreCase(tag, "td")) or std.ascii.eqlIgnoreCase(tag, "colgroup")) or std.ascii.eqlIgnoreCase(tag, "col"));
