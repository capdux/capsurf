        var stack: [64]NodeId = @as([64]NodeId, @splat(@as(NodeId, (if (comptime @typeInfo(NodeId) == .@"enum") @as(NodeId, @enumFromInt(0)) else @as(NodeId, 0)))));
        _ = &stack;
        var depths: [64]usize = @as([64]usize, @splat(@as(usize, (if (comptime @typeInfo(@TypeOf(0)) == .@"enum") cp_cast_int(usize, @intFromEnum(0)) else cp_cast_int(usize, 0)))));
        _ = &depths;
        var stack_len: usize = 0;
        _ = &stack_len;
        if (doc.getNode(table_id)) |t_node| {
            _ = &t_node;
            var c = t_node.first_child;
            _ = &c;
            while ((c != NULL_NODE)) {
                if ((stack_len < 64)) {
                    stack[cp_cast_int(usize, stack_len)] = c;
                    depths[cp_cast_int(usize, stack_len)] = 1;
                    stack_len = (stack_len + 1);
                }
                if (doc.getNode(c)) |cn| {
                    _ = &cn;
                    c = cn.next_sibling;
                } else {
                    break;
                }
            }
        }
        while ((stack_len > 0)) {
            stack_len = (stack_len - 1);
            const curr_id = stack[@as(usize, @intCast(stack_len))];
            const depth = depths[@as(usize, @intCast(stack_len))];
            if (doc.getNode(curr_id)) |curr| {
                _ = &curr;
                if ((curr.node_type == NodeType.Element)) {
                    const tag = curr.tag_name;
                    if ((std.ascii.eqlIgnoreCase(tag, "caption") or std.ascii.eqlIgnoreCase(tag, "th"))) {
                        data_signals = (data_signals + 1);
                        break;
                    }
                    if (std.ascii.eqlIgnoreCase(tag, "td")) {
                        if ((((curr.getAttribute("scope") != null) or (curr.getAttribute("headers") != null)) or (curr.getAttribute("abbr") != null))) {
                            data_signals = (data_signals + 1);
                            break;
                        }
                    }
                    if (std.ascii.eqlIgnoreCase(tag, "table")) {
                        continue;
                    }
                    if ((depth < 5)) {
                        var c = curr.first_child;
                        _ = &c;
                        while ((c != NULL_NODE)) {
                            if ((stack_len < 64)) {
                                stack[cp_cast_int(usize, stack_len)] = c;
                                depths[cp_cast_int(usize, stack_len)] = (depth + 1);
                                stack_len = (stack_len + 1);
                            }
                            if (doc.getNode(c)) |cn| {
                                _ = &cn;
                                c = cn.next_sibling;
                            } else {
                                break;
                            }
                        }
                    }
                }
            }
        }
        return (data_signals == 0);
}

pub fn getFirstToken(s: []const u8) []const u8 {
        var it = std.mem.tokenizeAny(u8, s, " \t\r\n");
        _ = &it;
        if (it.next()) |tok| {
            _ = &tok;
            return tok;
        }
        return "";
}

pub fn getExplicitRole(node: *const NodeData) ?[]const u8 {
        const role_opt = node.getAttribute("role");
        if ((role_opt != null)) {
            const tok = getFirstToken(role_opt.?);
            if ((tok.len > 0)) {
                return tok;
            }
        }
        return null;
}

pub fn computeImplicitRole(tag: []const u8, node: *const NodeData) []const u8 {
        if (std.ascii.eqlIgnoreCase(tag, "button")) {
            return "button";
        }
        if ((std.ascii.eqlIgnoreCase(tag, "a") or std.ascii.eqlIgnoreCase(tag, "area"))) {
            return (if ((node.getAttribute("href") != null)) "link" else "generic");
        }
        if (((((tag.len == 2) and ((tag[0] == 104) or (tag[0] == 72))) and (tag[1] >= 49)) and (tag[1] <= 54))) {
            return "heading";
        }
        if (std.ascii.eqlIgnoreCase(tag, "input")) {
            const typ = ((node.getAttribute("type")) orelse ("text"));
            if ((((std.ascii.eqlIgnoreCase(typ, "button") or std.ascii.eqlIgnoreCase(typ, "submit")) or std.ascii.eqlIgnoreCase(typ, "reset")) or std.ascii.eqlIgnoreCase(typ, "image"))) {
                return "button";
            }
            if (std.ascii.eqlIgnoreCase(typ, "checkbox")) {
                return "checkbox";
            }
            if (std.ascii.eqlIgnoreCase(typ, "radio")) {
                return "radio";
            }
            if (std.ascii.eqlIgnoreCase(typ, "range")) {
                return "slider";
            }
            if (std.ascii.eqlIgnoreCase(typ, "number")) {
                return "spinbutton";
            }
            if (std.ascii.eqlIgnoreCase(typ, "search")) {
                return "searchbox";
            }
            return "textbox";
        }
        if (std.ascii.eqlIgnoreCase(tag, "img")) {
            if (node.getAttribute("alt")) |alt| {
                _ = &alt;
                if ((alt.len == 0)) {
                    return "presentation";
                }
            }
            return "image";
        }
        if (std.ascii.eqlIgnoreCase(tag, "form")) {
            return "form";
        }
        if (std.ascii.eqlIgnoreCase(tag, "select")) {
            if ((node.getAttribute("multiple") != null)) {
                return "listbox";
            }
            return "combobox";
        }
        if (std.ascii.eqlIgnoreCase(tag, "textarea")) {
            return "textbox";
        }
        if (((std.ascii.eqlIgnoreCase(tag, "ul") or std.ascii.eqlIgnoreCase(tag, "ol")) or std.ascii.eqlIgnoreCase(tag, "menu"))) {
            return "list";
        }
        if (std.ascii.eqlIgnoreCase(tag, "li")) {
            return "listitem";
        }
        if (std.ascii.eqlIgnoreCase(tag, "table")) {
            return "table";
        }
        if (std.ascii.eqlIgnoreCase(tag, "tr")) {
            return "row";
        }
        if (std.ascii.eqlIgnoreCase(tag, "td")) {
            return "cell";
        }
        if (std.ascii.eqlIgnoreCase(tag, "th")) {
            if (node.getAttribute("scope")) |sc| {
                _ = &sc;
                if (std.ascii.eqlIgnoreCase(sc, "row")) {
                    return "rowheader";
                }
            }
            return "columnheader";
        }
        if (((std.ascii.eqlIgnoreCase(tag, "thead") or std.ascii.eqlIgnoreCase(tag, "tbody")) or std.ascii.eqlIgnoreCase(tag, "tfoot"))) {
            return "rowgroup";
        }
        if (std.ascii.eqlIgnoreCase(tag, "nav")) {
            return "navigation";
        }
        if (std.ascii.eqlIgnoreCase(tag, "header")) {
            return "banner";
        }
        if (std.ascii.eqlIgnoreCase(tag, "footer")) {
            return "contentinfo";
        }
        if (std.ascii.eqlIgnoreCase(tag, "main")) {
            return "main";
        }
        if (std.ascii.eqlIgnoreCase(tag, "aside")) {
            return "complementary";
        }
        if (std.ascii.eqlIgnoreCase(tag, "section")) {
            if (((node.getAttribute("aria-label") != null) or (node.getAttribute("aria-labelledby") != null))) {
                return "region";
            }
            return "generic";
        }
        if (std.ascii.eqlIgnoreCase(tag, "article")) {
            return "article";
        }
        if (std.ascii.eqlIgnoreCase(tag, "p")) {
            return "paragraph";
        }
        if (std.ascii.eqlIgnoreCase(tag, "hr")) {
            return "separator";
        }
        if (std.ascii.eqlIgnoreCase(tag, "dialog")) {
            return "dialog";
        }
        if (std.ascii.eqlIgnoreCase(tag, "summary")) {
            return "button";
        }
        if (std.ascii.eqlIgnoreCase(tag, "figure")) {
            return "figure";
        }
        if ((std.ascii.eqlIgnoreCase(tag, "caption") or std.ascii.eqlIgnoreCase(tag, "figcaption"))) {
            return "caption";
        }
        if (std.ascii.eqlIgnoreCase(tag, "blockquote")) {
            return "blockquote";
        }
        if (std.ascii.eqlIgnoreCase(tag, "code")) {
            return "code";
        }
        if (std.ascii.eqlIgnoreCase(tag, "time")) {
            return "time";
        }
        if (std.ascii.eqlIgnoreCase(tag, "strong")) {
            return "strong";
        }
        if (std.ascii.eqlIgnoreCase(tag, "em")) {
            return "emphasis";
        }
        if (std.ascii.eqlIgnoreCase(tag, "sub")) {
            return "subscript";
        }
        if (std.ascii.eqlIgnoreCase(tag, "sup")) {
            return "superscript";
        }
        if (std.ascii.eqlIgnoreCase(tag, "mark")) {
            return "mark";
        }
        if (std.ascii.eqlIgnoreCase(tag, "del")) {
            return "deletion";
        }
        if (std.ascii.eqlIgnoreCase(tag, "ins")) {
            return "insertion";
        }
        if ((std.ascii.eqlIgnoreCase(tag, "details") or std.ascii.eqlIgnoreCase(tag, "fieldset"))) {
            return "group";
        }
        if (std.ascii.eqlIgnoreCase(tag, "svg")) {
            return "graphics-document";
        }
        if (std.ascii.eqlIgnoreCase(tag, "html")) {
            return "document";
        }
        if (std.ascii.eqlIgnoreCase(tag, "body")) {
            return "generic";
        }
        if (std.ascii.eqlIgnoreCase(tag, "option")) {
            return "option";
        }
        if (std.ascii.eqlIgnoreCase(tag, "datalist")) {
            return "listbox";
        }
        if (std.ascii.eqlIgnoreCase(tag, "meter")) {
            return "meter";
        }
        if (std.ascii.eqlIgnoreCase(tag, "progress")) {
            return "progressbar";
        }
        if (std.ascii.eqlIgnoreCase(tag, "search")) {
            return "search";
        }
        if (std.ascii.eqlIgnoreCase(tag, "iframe")) {
            return "Iframe";
        }
        return "generic";
}

pub fn isFocusable(tag: []const u8, node: *const NodeData) bool {
        if ((node.getAttribute("disabled") != null)) {
            return false;
        }
        if (((((std.ascii.eqlIgnoreCase(tag, "button") or std.ascii.eqlIgnoreCase(tag, "select")) or std.ascii.eqlIgnoreCase(tag, "textarea")) or std.ascii.eqlIgnoreCase(tag, "summary")) or std.ascii.eqlIgnoreCase(tag, "iframe"))) {
            return true;
        }
        if (std.ascii.eqlIgnoreCase(tag, "input")) {
            const typ = ((node.getAttribute("type")) orelse ("text"));
            return (!std.ascii.eqlIgnoreCase(typ, "hidden"));
        }
        if ((std.ascii.eqlIgnoreCase(tag, "a") or std.ascii.eqlIgnoreCase(tag, "area"))) {
            return (node.getAttribute("href") != null);
        }
        if ((node.getAttribute("tabindex") != null)) {
            return true;
        }
        if (node.getAttribute("contenteditable")) |ce| {
            _ = &ce;
            return (!std.ascii.eqlIgnoreCase(ce, "false"));
        }
        return false;
}

pub fn collectSubtreeTextInternal(doc: *const Document, node_id: NodeId, out: []u8, depth: usize) usize {
        if (((depth > 16) or (out.len == 0))) {
            return 0;
        }
        var offset: usize = 0;
        _ = &offset;
        var curr = doc.getFirstChild(node_id);
        _ = &curr;
        while (((curr != NULL_NODE) and (offset < out.len))) {
            if (doc.getNode(curr)) |n| {
                _ = &n;
                if ((n.node_type == NodeType.Text)) {
                    const txt = std.mem.trim(u8, n.text_content, " \t\r\n");
                    if ((txt.len > 0)) {
                        if ((((offset > 0) and (offset < out.len)) and (out[@as(usize, @intCast((offset - 1)))] != 32))) {
                            out[cp_cast_int(usize, offset)] = 32;
                            offset = (offset + 1);
                        }
                        const copy_len = @min(txt.len, (out.len - offset));
                        _ = @memcpy(out[offset..(offset + copy_len)], txt[0..copy_len]);
                        offset = (offset + copy_len);
                    }
                } else {
                    if ((n.node_type == NodeType.Element)) {
                        if ((!isSkipTag(n.tag_name))) {
                            const sub_len = collectSubtreeTextInternal(doc, curr, out[offset..], (depth + 1));
                            offset = (offset + sub_len);
                        }
                    }
                }
                curr = n.next_sibling;
            } else {
                break;
            }
        }
        return offset;
}

pub fn findDocumentTitle(doc: *const Document) []const u8 {
        var i: usize = 1;
        _ = &i;
        while ((i < doc.nodeCount())) : (i = (i + 1)) {
            if (doc.getNode(@intCast(i))) |n| {
                _ = &n;
                if (((n.node_type == NodeType.Element) and std.ascii.eqlIgnoreCase(n.tag_name, "title"))) {
                    var curr = n.first_child;
                    _ = &curr;
                    while ((curr != NULL_NODE)) {
                        if (doc.getNode(curr)) |c| {
                            _ = &c;
                            if ((c.node_type == NodeType.Text)) {
                                const trimmed = std.mem.trim(u8, c.text_content, " \t\r\n");
                                if ((trimmed.len > 0)) {
                                    return trimmed;
                                }
                            }
                            curr = c.next_sibling;
                        } else {
                            break;
                        }
                    }
                }
            }
        }
        return "";
}

pub fn buildAXTree(doc: *Document, out_buf: []u8) []const u8 {
        var tree = (blk_catch_17: { break :blk_catch_17 ((std.heap.c_allocator.create(AXTree)) catch |__ce_17| { _ = &__ce_17; return "{\"nodes\":[]}"; }); });
        _ = &tree;
        defer {
        _ = std.heap.c_allocator.destroy(tree);
        }
        tree.* = AXTree{  };
        var doc_title = findDocumentTitle(doc);
        _ = &doc_title;
        if ((doc_title.len == 0)) {
            doc_title = "Document";
        }
        _ = tree.buildFromDoc(doc, doc_title, "", "capsurf-frame-001");
        var w = JsonWriter.init(out_buf);
        _ = &w;
        _ = w.writeRaw("{\"nodes\":[");
        var i: usize = 0;
        _ = &i;
        while ((i < tree.node_count)) : (i = (i + 1)) {
            if ((i > 0)) {
                _ = w.writeByte(44);
            }
            _ = w.writeAxNode((&tree.nodes[@as(usize, @intCast(i))]));
        }
        _ = w.writeRaw("]}");
        if (w.overflow) {
            return "{\"nodes\":[]}";
        }
        return w.getWritten();
}
