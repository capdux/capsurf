pub fn inlineStyleDisplayNone(style: []const u8) bool {
        var it = std.mem.splitScalar(u8, style, 59);
        _ = &it;
        while (it.next()) |decl| {
            const colon_opt = std.mem.indexOfScalar(u8, decl, 58);
            if ((colon_opt == null)) {
                continue;
            }
            const colon = colon_opt.?;
            if ((colon == 0)) {
                continue;
            }
            const prop = std.mem.trim(u8, decl[0..colon], " \t\r\n");
            const val = std.mem.trim(u8, decl[(colon + 1)..], " \t\r\n");
            if (std.ascii.eqlIgnoreCase(prop, "display")) {
                if (std.ascii.startsWithIgnoreCase(val, "none")) {
                    return true;
                }
            }
        }
        return false;
}

pub fn inlineStyleVisibilityHidden(style: []const u8) bool {
        var it = std.mem.splitScalar(u8, style, 59);
