                        _ = self.buildNode(doc, child_id, ax_idx, frame_id, node_hidden, aria_hidden, vis_hidden, in_layout_table);
                        child_id = next_sib;
                    } else {
                        break;
                    }
                }
                return ax_idx;
            }
            return null;
    }

pub fn buildFromDoc(self: *AXTree, doc: *const Document, root_title: []const u8, root_url: []const u8, frame_id: []const u8) void {
            self.node_count = 0;
            self.text_pool_len = 0;
            self.root_url = root_url;
            const root_ax_opt = self.allocNode();
            if ((root_ax_opt == null)) {
                return;
            }
            const root_idx = root_ax_opt.?;
            self.nodes[@as(usize, @intCast(root_idx))].node_id = "root";
            self.nodes[@as(usize, @intCast(root_idx))].ignored = false;
            self.nodes[@as(usize, @intCast(root_idx))].role = AxValue.fromRole("RootWebArea", true);
            self.nodes[@as(usize, @intCast(root_idx))].chrome_role = 144;
            self.nodes[@as(usize, @intCast(root_idx))].name = AxValue.fromComputedString(root_title);
            self.nodes[@as(usize, @intCast(root_idx))].value = AxValue.fromString("string", root_url);
            self.nodes[@as(usize, @intCast(root_idx))].backend_dom_node_id = doc.root_element;
            self.nodes[@as(usize, @intCast(root_idx))].frame_id = frame_id;
            _ = self.nodes[@as(usize, @intCast(root_idx))].addProperty(AXProperty.create("url", AxValue.fromString("string", root_url)));
            _ = self.nodes[@as(usize, @intCast(root_idx))].addProperty(AXProperty.create("focusable", AxValue.fromBool("booleanOrUndefined", true)));
            if ((doc.root_element != NULL_NODE)) {
                _ = self.buildNode(doc, doc.root_element, root_idx, frame_id, false, false, false, false);
            }
    }

pub fn buildFromSession(self: *AXTree, session: *CdpPageSession) void {
            self.live_selects_len = 0;
            self.has_live_state = false;
            if (session.has_document) {
                _ = self.fetchLiveState(session);
            }
            _ = self.buildFromDoc((&session.doc), session.title, session.url, session.frame_id);
    }
};

