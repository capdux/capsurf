pub fn isSkipTag(tag: []const u8) bool {
        return ((((((((std.ascii.eqlIgnoreCase(tag, "script") or std.ascii.eqlIgnoreCase(tag, "style")) or std.ascii.eqlIgnoreCase(tag, "noscript")) or std.ascii.eqlIgnoreCase(tag, "template")) or std.ascii.eqlIgnoreCase(tag, "meta")) or std.ascii.eqlIgnoreCase(tag, "link")) or std.ascii.eqlIgnoreCase(tag, "base")) or std.ascii.eqlIgnoreCase(tag, "head")) or std.ascii.eqlIgnoreCase(tag, "title"));
