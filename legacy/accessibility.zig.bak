pub fn findSelectedOptionText(self: *AXTree, doc: *const Document, select_id: NodeId) ?[]const u8 {
            if (self.has_live_state) {
                var i: usize = 0;
                _ = &i;
                while ((i < self.live_selects_len)) : (i = (i + 1)) {
                    if ((self.live_selects[@as(usize, @intCast(i))].select_nid == select_id)) {
                        const ls = (&self.live_selects[@as(usize, @intCast(i))]);
                        if (((ls.selected_index < 0) or (ls.selected_opts_len == 0))) {
                            return null;
                        }
                        const chosen = ls.selected_opts[0];
                        if ((chosen != NULL_NODE)) {
                            if (doc.getNode(chosen)) |opt_node| {
                                _ = &opt_node;
                                if (opt_node.getAttribute("label")) |lbl| {
                                    _ = &lbl;
                                    return lbl;
                                }
                                const txt = self.collectSubtreeText(doc, chosen);
                                if ((txt.len > 0)) {
                                    return txt;
                                }
                                if (opt_node.getAttribute("value")) |val| {
                                    _ = &val;
                                    return val;
