pub fn isNoBox(node: *const NodeData) bool {
        if ((node.getAttribute("hidden") != null)) {
            return true;
        }
        if (std.ascii.eqlIgnoreCase(node.tag_name, "input")) {
            if (node.getAttribute("type")) |typ| {
                _ = &typ;
                if (std.ascii.eqlIgnoreCase(typ, "hidden")) {
                    return true;
                }
            }
        }
        if ((node.inline_style.len > 0)) {
            if (inlineStyleDisplayNone(node.inline_style)) {
                return true;
            }
        }
        return false;
}

