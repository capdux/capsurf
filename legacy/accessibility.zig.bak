}

pub fn inlineStyleVisibilityVisible(style: []const u8) bool {
        var it = std.mem.splitScalar(u8, style, 59);
        _ = &it;
        while (it.next()) |decl| {
            const colon_opt = std.mem.indexOfScalar(u8, decl, 58);
            if ((colon_opt == null)) {
