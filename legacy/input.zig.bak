            if (std.mem.eql(u8, req.method, "Input.setIgnoreInputEvents")) {
                const ignore = ((extractJsonBool(req.params_raw, "ignore")) orelse (false));
                _ = &ignore;
                return CdpResponse.ok(req.id, "{}");
            }
            if (std.mem.startsWith(u8, req.method, "Input.")) {
                return CdpResponse.ok(req.id, "{}");
            }
            return CdpResponse.err(req.id, -32601, "'Input' domain method not implemented");
    }
};


pub fn hitTest(session: *CdpPageSession, x: f32, y: f32) NodeId {
        var best_node: NodeId = NULL_NODE;
        _ = &best_node;
        var i: usize = 0;
        _ = &i;
        const count = session.layout.boxes.items.len;
        while ((i < count)) : (i = (i + 1)) {
            const box = session.layout.boxes.items[@as(usize, @intCast(i))];
            if (((box.rect.visible and (box.rect.width > 0.0)) and (box.rect.height > 0.0))) {
                if (((((x >= box.rect.x) and (x <= (box.rect.x + box.rect.width))) and (y >= box.rect.y)) and (y <= (box.rect.y + box.rect.height)))) {
                    best_node = box.node_id;
                }
            }
        }
        return best_node;
}

pub fn escapeJsString(input_str: []const u8, out: []u8) usize {
        var ei: usize = 0;
        _ = &ei;
        var i: usize = 0;
        _ = &i;
        while ((i < input_str.len)) : (i = (i + 1)) {
            const c = input_str[@as(usize, @intCast(i))];
            if ((((c == 34) or (c == 92)) or (c == 39))) {
                if (((ei + 1) < out.len)) {
                    out[cp_cast_int(usize, ei)] = 92;
                }
                ei = (ei + 1);
            }
            if ((ei < out.len)) {
                out[cp_cast_int(usize, ei)] = c;
            }
            ei = (ei + 1);
        }
        return ei;
}

pub fn applyInputText(session: *CdpPageSession, text: []const u8, key: []const u8) void {
